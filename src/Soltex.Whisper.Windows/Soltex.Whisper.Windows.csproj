<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Soltex.Whisper.Windows</RootNamespace>
    <AssemblyName>Soltex.Whisper.Windows</AssemblyName>
    <Description>Bounded Windows capture, shortcut, target-inspection, insertion, and verified-submit adapters for the provider-neutral Soltex Whisper core.</Description>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Soltex.Audio\Soltex.Audio.csproj" />
    <ProjectReference Include="..\Soltex.Security\Soltex.Security.csproj" />
    <ProjectReference Include="..\Soltex.Whisper\Soltex.Whisper.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Soltex.Whisper.Windows.Tests" />
    <InternalsVisibleTo Include="Soltex.App.Tests" />
  </ItemGroup>
</Project>
