<Window x:Class="WaveSlate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WaveSlate"
        Width="1280"
        Height="820"
        MinWidth="1040"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#1F1F1F"
        Foreground="#D1CFC0"
        FontFamily="{StaticResource UiFont}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Window.Resources>
        <FontFamily x:Key="DisplayFont">Georgia</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#252522" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#2B2B27" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3B3A34" />
        <SolidColorBrush x:Key="MutedBrush" Color="#96938A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#F76F53" />
        <SolidColorBrush x:Key="SignalBrush" Color="#7ED0A7" />
        <SolidColorBrush x:Key="SelectedNavBrush" Color="#372925" />
        <SolidColorBrush x:Key="NavRestBrush" Color="Transparent" />
        <SolidColorBrush x:Key="WarningBrush" Color="#E6B866" />
        <SolidColorBrush x:Key="DangerBrush" Color="#F18279" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="22" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#211714" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
            <Setter Property="Foreground" Value="#D1CFC0" />
            <Setter Property="BorderBrush" Value="#45443D" />
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource NavRestBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="{StaticResource RaisedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1B1B19" />
            <Setter Property="Foreground" Value="#E5E2D5" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="#8058453F" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="EyebrowStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D1CFC0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#3B3A34" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="#21211E" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2B2B27" />
            <Setter Property="Foreground" Value="#BDBAAF" />
            <Setter Property="BorderBrush" Value="#3B3A34" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="198" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#181816" BorderBrush="#34332E" BorderThickness="0,0,1,0">
            <Grid Margin="18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="WaveSlate" FontFamily="{StaticResource DisplayFont}" FontSize="26" />
                    <TextBlock Text="LOCAL CONTROL SURFACE"
                               Margin="1,6,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10"
                               FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button x:Name="MixerNavButton" Style="{StaticResource NavButton}" Click="MixerNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="01" FontFamily="{StaticResource MonoFont}" Foreground="#66645E" />
                            <TextBlock Grid.Column="1" Text="Mixer" />
                        </Grid>
                    </Button>
                    <Button x:Name="ClipsNavButton" Style="{StaticResource NavButton}" Click="ClipsNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="02" FontFamily="{StaticResource MonoFont}" Foreground="#66645E" />
                            <TextBlock Grid.Column="1" Text="Clips" />
                        </Grid>
                    </Button>
                    <Button x:Name="SecurityNavButton"
                            Style="{StaticResource NavButton}"
                            Background="{StaticResource SelectedNavBrush}"
                            Foreground="{StaticResource AccentBrush}"
                            Click="SecurityNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="03" FontFamily="{StaticResource MonoFont}" Foreground="#8E5A4E" />
                            <TextBlock Grid.Column="1" Text="Security" />
                        </Grid>
                    </Button>
                    <Button x:Name="RemoteNavButton" Style="{StaticResource NavButton}" Click="RemoteNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="04" FontFamily="{StaticResource MonoFont}" Foreground="#66645E" />
                            <TextBlock Grid.Column="1" Text="Remote Assist" />
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Border Background="#20231F" BorderBrush="#36443C" BorderThickness="1" CornerRadius="12" Padding="13">
                        <StackPanel>
                            <TextBlock Text="Protected locally" Foreground="{StaticResource SignalBrush}" FontWeight="SemiBold" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="Uses the antivirus already registered with Windows. No duplicate resident engine."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" />
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="1,14,0,0" Text="Clean-room Windows scaffold" Foreground="#66645E" FontFamily="{StaticResource MonoFont}" FontSize="10" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="34,28,34,26">
            <Grid x:Name="SecurityPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowStyle}" Text="03 / SYSTEM DEFENSE" />
                        <TextBlock Margin="0,5,0,0" Text="Security" FontFamily="{StaticResource DisplayFont}" FontSize="38" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="Windows protection health, focused scans, safe imports, and recoverable quarantine."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="14" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Content="Open Windows Security"
                            Click="OpenWindowsSecurity_Click" />
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border x:Name="HealthHero" Style="{StaticResource CardStyle}" BorderBrush="#365445" Background="#20251F">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="HealthDot" Width="16" Height="16" Fill="{StaticResource SignalBrush}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="HealthTitle" Text="Checking Windows protection…" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="HealthDetail"
                                               Margin="0,6,0,0"
                                               Text="WaveSlate is reading supported Windows Security and Defender status."
                                               Foreground="#B8C4B9"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ProgressBar x:Name="BusyProgress" Width="90" Height="5" Margin="0,0,12,0" IsIndeterminate="True" Visibility="Collapsed" />
                                    <Button x:Name="RefreshButton" Style="{StaticResource SecondaryButton}" Content="Refresh" Click="Refresh_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Defender real-time" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <TextBlock x:Name="RealTimeStatus" Margin="0,5,0,0" Text="Checking" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Defender behavior" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <TextBlock x:Name="BehaviorStatus" Margin="0,5,0,0" Text="Checking" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Defender cloud" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <TextBlock x:Name="CloudStatus" Margin="0,5,0,0" Text="Checking" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Intelligence" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <TextBlock x:Name="SignatureStatus" Margin="0,5,0,0" Text="Checking" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Scan with Windows Defender" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="WaveSlate delegates detection and remediation to the installed Windows engine."
                                               Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                                <WrapPanel Grid.Column="1" Margin="18,0,0,0">
                                    <Button x:Name="QuickScanButton" Margin="0,0,8,0" Style="{StaticResource ActionButton}" Content="Quick scan" Click="QuickScan_Click" />
                                    <Button x:Name="FileScanButton" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Content="Scan file" Click="FileScan_Click" />
                                    <Button x:Name="FolderScanButton" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Content="Scan folder" Click="FolderScan_Click" />
                                    <Button x:Name="UpdateButton" Style="{StaticResource SecondaryButton}" Content="Update" Click="Update_Click" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="190" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Windows protection activity" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Bounded Defender Operational events; file and process paths are never shown."
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="EventQueryStatus"
                                               Grid.Column="1"
                                               Text="Checking"
                                               Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <DataGrid x:Name="DefenderEventGrid" Grid.Row="2" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="When" Binding="{Binding When}" Width="125" />
                                        <DataGridTextColumn Header="Level" Binding="{Binding Severity}" Width="90" />
                                        <DataGridTextColumn Header="Event" Binding="{Binding Title}" Width="210" />
                                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                    <RowDefinition Height="145" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="WaveSlate quarantine" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,4,0,0" Text="Only explicit, recoverable file isolation." Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="QuarantineCount" Grid.Column="1" Text="0 items" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <DataGrid x:Name="QuarantineGrid" Grid.Row="2" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" />
                                            <DataGridTextColumn Header="Detection" Binding="{Binding Detection}" Width="2*" />
                                            <DataGridTextColumn Header="When" Binding="{Binding When}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Content="Restore" Click="Restore_Click" />
                                        <Button Style="{StaticResource SecondaryButton}" Foreground="#FF9BA2" Content="Delete" Click="Delete_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Activity" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0" Text="Paths are hashed in the local audit log." Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <ListBox x:Name="ActivityList"
                                             Grid.Row="2"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#C9C6BB"
                                             FontSize="12" />
                                    <Button Grid.Row="4"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="Open protected imports"
                                            Click="OpenImports_Click" />
                                </Grid>
                            </Border>
                        </Grid>

                        <TextBlock Margin="2,14,2,4"
                                   Foreground="#77746D"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="Scope: this build is a Windows security companion, not a registered third-party antivirus provider. Defender or another registered provider supplies system-wide real-time protection. WaveSlate adds focused orchestration and protects its own import boundary." />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="RemotePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowStyle}" Text="04 / CONSENT-FIRST BRIDGE" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="Remote Assist"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="38" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="Open an authorized RustDesk session without moving its transport or credentials into WaveSlate."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="14" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            VerticalAlignment="Top"
                            Style="{StaticResource SecondaryButton}"
                            Content="Source &amp; license"
                            Click="OpenRustDeskSource_Click" />
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Border Background="#292622"
                                    BorderBrush="#514239"
                                    BorderThickness="1"
                                    CornerRadius="24"
                                    Padding="28">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="RemoteTrustDot"
                                                 Width="13"
                                                 Height="13"
                                                 Fill="{StaticResource MutedBrush}"
                                                 VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="RemoteTrustState"
                                                       Text="RustDesk is not connected"
                                                       FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="23" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="External runtime boundary"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10" />
                                        </StackPanel>
                                        <Border Grid.Column="3"
                                                VerticalAlignment="Top"
                                                Background="#1D1D1A"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="10,6">
                                            <TextBlock x:Name="RemoteTrustPill"
                                                       Text="NOT CONNECTED"
                                                       Foreground="{StaticResource WarningBrush}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <TextBlock x:Name="RemoteTrustDetail"
                                               Grid.Row="2"
                                               Text="Choose an installed, signed RustDesk.exe. WaveSlate never bundles or silently downloads the remote-control runtime."
                                               Foreground="#B8B4A9"
                                               TextWrapping="Wrap"
                                               LineHeight="21" />

                                    <Border Grid.Row="4"
                                            Background="#1D1D1A"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="SELECTED CLIENT"
                                                       Foreground="#77746D"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="9" />
                                            <TextBlock x:Name="RemoteExecutablePath"
                                                       Margin="0,6,0,0"
                                                       Text="No external client selected"
                                                       Foreground="#D1CFC0"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="RemoteFingerprint"
                                                       Margin="0,7,0,0"
                                                       Text="SHA-256 unavailable"
                                                       Foreground="#77746D"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="9"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Row="6" Orientation="Horizontal">
                                        <Button Margin="0,0,10,0"
                                                Style="{StaticResource SecondaryButton}"
                                                Content="Choose RustDesk.exe"
                                                Click="SelectRustDesk_Click" />
                                        <Button x:Name="RemoteShareButton"
                                                Style="{StaticResource ActionButton}"
                                                Content="Open sharing interface"
                                                IsEnabled="False"
                                                Click="ShareRemote_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Margin="0,18,0,0" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="9" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Control an authorized peer"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="22" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="The ID is validated and passed as one literal argument. Secrets never cross this boundary."
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBox x:Name="RemotePeerIdInput"
                                             Grid.Row="2"
                                             Style="{StaticResource FieldStyle}"
                                             MaxLength="64"
                                             ToolTip="RustDesk peer ID" />
                                    <TextBlock x:Name="RemotePeerHint"
                                               Grid.Row="4"
                                               Text="Enter 3–64 letters, numbers, hyphens, or underscores"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11" />
                                    <Button x:Name="RemoteConnectButton"
                                            Grid.Row="6"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource ActionButton}"
                                            Content="Connect with RustDesk"
                                            IsEnabled="False"
                                            Click="ConnectRemote_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource CardStyle}" Background="#222620" BorderBrush="#3D4C42">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EyebrowStyle}" Foreground="{StaticResource SignalBrush}" Text="SESSION SIGNAL" />
                                    <TextBlock x:Name="RemoteSessionStatus"
                                               Margin="0,12,0,0"
                                               Text="No launch requested"
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontSize="21" />
                                    <TextBlock x:Name="RemoteSessionDetail"
                                               Margin="0,8,0,0"
                                               Text="WaveSlate is idle. RustDesk remains the visible owner of any future session."
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="20" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,18,0,0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Permission boundary"
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontSize="21" />
                                    <TextBlock Margin="0,6,0,18"
                                               Text="A deliberately small bridge with visible stops."
                                               Foreground="{StaticResource MutedBrush}" />

                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="01" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource MonoFont}" FontSize="10" />
                                        <TextBlock Grid.Column="1" Text="Choose a local signed client" TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="02" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource MonoFont}" FontSize="10" />
                                        <TextBlock Grid.Column="1" Text="Confirm each WaveSlate launch" TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="03" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource MonoFont}" FontSize="10" />
                                        <TextBlock Grid.Column="1" Text="Authenticate and consent in RustDesk" TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="04" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource MonoFont}" FontSize="10" />
                                        <TextBlock Grid.Column="1" Text="End and inspect the session there" TextWrapping="Wrap" />
                                    </Grid>

                                    <Border Margin="0,20,0,0"
                                            Background="#1D1D1A"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="13">
                                        <TextBlock Text="No bundled binary · no password flags · no elevation · no service install"
                                                   Foreground="#A8A49A"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="MixerPanel" Visibility="Collapsed">
                <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowStyle}" Text="01 / AUDIO ROUTING" />
                        <TextBlock Margin="0,7,0,0" Text="Mixer" FontFamily="{StaticResource DisplayFont}" FontSize="38" />
                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Text="Audio routing and parametric EQ remain a documented scaffold boundary in this reconstruction. The Security module is the implemented focus of this handoff." />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="ClipsPanel" Visibility="Collapsed">
                <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowStyle}" Text="02 / CAPTURE" />
                        <TextBlock Margin="0,7,0,0" Text="Clips" FontFamily="{StaticResource DisplayFont}" FontSize="38" />
                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Text="Rolling capture, hardware encoding, and the click-through overlay remain documented future stages. No game injection or protected-content bypass is permitted." />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
