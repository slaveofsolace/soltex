<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Soltex.NativeShell</RootNamespace>
    <AssemblyName>Soltex.NativeShell</AssemblyName>
    <Description>Bounded Windows-native windowing adapter for the Soltex desktop shell.</Description>
    <WinUISDKReferences>false</WinUISDKReferences>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences"
                      Version="2.1.6"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
