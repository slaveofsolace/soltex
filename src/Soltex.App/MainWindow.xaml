<Window x:Class="Soltex.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Soltex.App.Views"
        Title="Soltex"
        Width="1360"
        Height="860"
        MinWidth="1100"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource TrackBrush}"
                BorderThickness="0,0,1,0"
                TextElement.Foreground="{StaticResource TextBrush}"
                TextElement.FontFamily="{StaticResource UiFont}">
            <Grid Margin="14,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" Background="{StaticResource AccentQuietBrush}" BorderBrush="{StaticResource AccentDimBrush}" BorderThickness="1" CornerRadius="8">
                        <TextBlock Text="S" Foreground="{StaticResource AccentFocusBrush}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Soltex" Foreground="{StaticResource TextBrightBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="SYSTEM WORKSPACE" Margin="0,2,0,0" Foreground="{StaticResource QuietTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2">
                    <TextBlock Margin="10,0,0,6" Text="SYSTEM" Foreground="{StaticResource QuietTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" FontWeight="SemiBold" />
                    <Button x:Name="HomeNavButton" Style="{StaticResource NavButton}" Background="{StaticResource SelectedNavBrush}" Foreground="{StaticResource AccentBrush}" AutomationProperties.Name="Overview" Click="HomeNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Text="Overview" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="MonitoringNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Performance" Click="MonitoringNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Text="Performance" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="ApplicationsNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Applications" Click="ApplicationsNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Text="Applications" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Grid>
                    </Button>
                    <TextBlock Margin="10,17,0,6" Text="CONTROL" Foreground="{StaticResource QuietTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" FontWeight="SemiBold" />
                    <Button x:Name="MixerNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Audio" Click="MixerNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Text="Audio" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="SecurityNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Security" Click="SecurityNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Text="Security" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="RemoteNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Remote Assist" Click="RemoteNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8AF;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Text="Remote Assist" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Grid>
                    </Button>
                    <TextBlock Margin="10,17,0,6" Text="MAINTENANCE" Foreground="{StaticResource QuietTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" FontWeight="SemiBold" />
                    <Button x:Name="DevicesNavButton" Visibility="Collapsed" Style="{StaticResource NavButton}" AutomationProperties.Name="Device mesh preview" Click="DevicesNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE772;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Text="Device mesh" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="2" Text="PREVIEW" Foreground="{StaticResource WarningBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" />
                        </Grid>
                    </Button>
                    <Button x:Name="ClipsNavButton" Visibility="Collapsed" Style="{StaticResource NavButton}" AutomationProperties.Name="Capture preview" Click="ClipsNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Text="Capture" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="2" Text="PREVIEW" Foreground="{StaticResource WarningBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" />
                        </Grid>
                    </Button>
                    <Button x:Name="UpdateNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Updates" Click="UpdateNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Text="Updates" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Button x:Name="SettingsNavButton"
                            Margin="0,0,0,10"
                            Style="{StaticResource NavButton}"
                            AutomationProperties.Name="Settings"
                            Click="SettingsNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Text="Settings" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Grid>
                    </Button>
                    <Border x:Name="ProtectionSummaryBorder"
                            Background="{StaticResource QuietBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="11">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Ellipse x:Name="ProtectionSummaryDot" Width="7" Height="7" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ProtectionSummaryTitle" Grid.Column="1" Margin="8,0,0,0" Text="Protection status" FontWeight="SemiBold" />
                                <TextBlock x:Name="ProtectionSummaryState" Grid.Column="2" Text="CHECKING" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" />
                            </Grid>
                            <TextBlock x:Name="ProtectionSummaryDetail" Margin="15,5,0,0" Text="Reading Windows Security" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontCaption}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Grid Margin="3,10,3,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Local workspace" Foreground="{StaticResource QuietTextBrush}" FontSize="{StaticResource FontCaption}" />
                        <TextBlock Grid.Column="1" Text="v1 preview" Foreground="{StaticResource QuietTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="28,22,28,24"
              ClipToBounds="True"
              TextElement.Foreground="{StaticResource TextBrush}"
              TextElement.FontFamily="{StaticResource UiFont}">
            <views:HomeView x:Name="HomePanel" />
            <views:MonitoringView x:Name="MonitoringPanel" Visibility="Collapsed" />
            <views:ApplicationsView x:Name="ApplicationsPanel" Visibility="Collapsed" />
            <views:SettingsView x:Name="SettingsPanel" Visibility="Collapsed" />
            <views:DevicesView x:Name="DevicesPanel" Visibility="Collapsed" />

            <Grid x:Name="SecurityPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="PROTECTION" />
                        <TextBlock Margin="0,5,0,0" Text="Security" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FontDisplay}" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="Protection health, focused scans, safe imports, and recoverable quarantine."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   MaxWidth="680" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Content="Open Windows Security"
                            Click="OpenWindowsSecurity_Click" />
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border x:Name="HealthHero" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource SignalBorderBrush}" Background="{StaticResource SignalSurfaceBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="HealthDot" Width="16" Height="16" Fill="{StaticResource SignalBrush}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="HealthTitle" Text="Checking Windows protection…" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="HealthDetail"
                                               Margin="0,6,0,0"
                                               Text="Soltex is reading supported Windows Security and Defender status."
                                               Foreground="{StaticResource SignalTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ProgressBar x:Name="BusyProgress" Width="90" Height="5" Margin="0,0,12,0" IsIndeterminate="True" Visibility="Collapsed" />
                                    <Button x:Name="RefreshButton" Style="{StaticResource SecondaryButton}" Content="Refresh" Click="Refresh_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Defender real-time" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <TextBlock x:Name="RealTimeStatus" Margin="0,5,0,0" Text="Checking" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Defender behavior" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <TextBlock x:Name="BehaviorStatus" Margin="0,5,0,0" Text="Checking" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Defender cloud" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <TextBlock x:Name="CloudStatus" Margin="0,5,0,0" Text="Checking" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Style="{StaticResource CardStyle}" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Intelligence" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                    <TextBlock x:Name="SignatureStatus" Margin="0,5,0,0" Text="Checking" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Scan with Windows Defender" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,5,0,0"
                                               Text="Soltex delegates detection and remediation to the installed Windows engine."
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               ToolTip="Soltex delegates detection and remediation to the installed Windows engine." />
                                </StackPanel>
                                <WrapPanel Grid.Row="2">
                                    <Button x:Name="QuickScanButton" Margin="0,0,8,0" Style="{StaticResource ActionButton}" Content="Quick scan" Click="QuickScan_Click" />
                                    <Button x:Name="FileScanButton" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Content="Scan file" Click="FileScan_Click" />
                                    <Button x:Name="FolderScanButton" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Content="Scan folder" Click="FolderScan_Click" />
                                    <Button x:Name="UpdateButton" Style="{StaticResource SecondaryButton}" Content="Update" Click="Update_Click" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Windows protection activity" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="Bounded Defender Operational events; file and process paths are never shown."
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="EventQueryStatus"
                                                   Margin="0,0,10,0"
                                                   Text="Checking"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="SecurityActivityButton"
                                                Style="{StaticResource SecondaryButton}"
                                                Content="Show activity"
                                                AutomationProperties.Name="Show recent Windows protection activity"
                                                Click="SecurityActivity_Click" />
                                    </StackPanel>
                                </Grid>
                                <DataGrid x:Name="DefenderEventGrid"
                                          Grid.Row="2"
                                          Height="190"
                                          Visibility="Collapsed"
                                          SelectionMode="Single"
                                          AutomationProperties.Name="Recent Windows protection activity">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="When" Binding="{Binding When}" Width="125" />
                                        <DataGridTextColumn Header="Level" Binding="{Binding Severity}" Width="90" />
                                        <DataGridTextColumn Header="Event" Binding="{Binding Title}" Width="210" />
                                        <DataGridTemplateColumn Header="Detail" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Detail}"
                                                               TextWrapping="Wrap"
                                                               LineHeight="18"
                                                               ToolTip="{Binding Detail}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                    <RowDefinition Height="145" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Soltex quarantine" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,4,0,0" Text="Only explicit, recoverable file isolation." Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="QuarantineCount" Grid.Column="1" Text="0 items" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <DataGrid x:Name="QuarantineGrid" Grid.Row="2" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" />
                                            <DataGridTextColumn Header="Detection" Binding="{Binding Detection}" Width="2*" />
                                            <DataGridTextColumn Header="When" Binding="{Binding When}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Content="Restore" Click="Restore_Click" />
                                        <Button Style="{StaticResource SecondaryButton}" Foreground="{StaticResource DangerTextBrush}" Content="Delete" Click="Delete_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Activity" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0" Text="Paths are hashed in the local audit log." Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <ListBox x:Name="ActivityList"
                                             Grid.Row="2"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource TextBrush}"
                                             FontSize="12" />
                                    <Button Grid.Row="4"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="Open protected imports"
                                            Click="OpenImports_Click" />
                                </Grid>
                            </Border>
                        </Grid>

                        <TextBlock Margin="2,14,2,4"
                                   Foreground="{StaticResource QuietTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="Scope: this build is a Windows security companion, not a registered third-party antivirus provider. Defender or another registered provider supplies system-wide real-time protection. Soltex adds focused orchestration and protects its own import boundary." />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="RemotePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="REMOTE ASSIST" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="Remote Assist"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="{StaticResource FontDisplay}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="Open an authorized RustDesk session without moving its transport or credentials into Soltex."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="14" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            VerticalAlignment="Top"
                            Style="{StaticResource SecondaryButton}"
                            Content="Source &amp; license"
                            Click="OpenRustDeskSource_Click" />
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Border Background="{StaticResource HeroPanelBrush}"
                                    BorderBrush="{StaticResource HeroBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="24"
                                    Padding="28">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="20" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse x:Name="RemoteTrustDot"
                                                 Width="13"
                                                 Height="13"
                                                 Fill="{StaticResource MutedBrush}"
                                                 VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock x:Name="RemoteTrustState"
                                                       Text="RustDesk is not connected"
                                                       FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="23" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="External runtime boundary"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10" />
                                        </StackPanel>
                                        <Border Grid.Column="3"
                                                VerticalAlignment="Top"
                                                Background="{StaticResource InsetBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="10,6">
                                            <TextBlock x:Name="RemoteTrustPill"
                                                       Text="NOT CONNECTED"
                                                       Foreground="{StaticResource WarningBrush}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <TextBlock x:Name="RemoteTrustDetail"
                                               Grid.Row="2"
                                               Text="Choose an installed, signed RustDesk.exe. Soltex never bundles or silently downloads the remote-control runtime."
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="21" />

                                    <Border Grid.Row="4"
                                            Background="{StaticResource InsetBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="SELECTED CLIENT"
                                                       Foreground="{StaticResource QuietTextBrush}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="9" />
                                            <TextBlock x:Name="RemoteExecutablePath"
                                                       Margin="0,6,0,0"
                                                       Text="No external client selected"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="RemoteFingerprint"
                                                       Margin="0,7,0,0"
                                                       Text="SHA-256 unavailable"
                                                       Foreground="{StaticResource QuietTextBrush}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="9"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Row="6" Orientation="Horizontal">
                                        <Button Margin="0,0,10,0"
                                                Style="{StaticResource SecondaryButton}"
                                                Content="Choose RustDesk.exe"
                                                Click="SelectRustDesk_Click" />
                                        <Button x:Name="RemoteShareButton"
                                                Style="{StaticResource ActionButton}"
                                                Content="Open sharing interface"
                                                IsEnabled="False"
                                                Click="ShareRemote_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Margin="0,18,0,0" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="9" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Control an authorized peer"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="22" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="The ID is validated and passed as one literal argument. Secrets never cross the Soltex boundary."
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBox x:Name="RemotePeerIdInput"
                                             Grid.Row="2"
                                             Style="{StaticResource FieldStyle}"
                                             MaxLength="64"
                                             ToolTip="RustDesk peer ID" />
                                    <TextBlock x:Name="RemotePeerHint"
                                               Grid.Row="4"
                                               Text="Enter 3–64 letters, numbers, hyphens, or underscores"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11" />
                                    <Button x:Name="RemoteConnectButton"
                                            Grid.Row="6"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource ActionButton}"
                                            Content="Connect with RustDesk"
                                            IsEnabled="False"
                                            Click="ConnectRemote_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource CardStyle}" Background="{StaticResource SignalSurfaceBrush}" BorderBrush="{StaticResource SignalBorderBrush}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PageEyebrowStyle}" Foreground="{StaticResource SignalBrush}" Text="SESSION SIGNAL" />
                                    <TextBlock x:Name="RemoteSessionStatus"
                                               Margin="0,12,0,0"
                                               Text="No launch requested"
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontSize="21" />
                                    <TextBlock x:Name="RemoteSessionDetail"
                                               Margin="0,8,0,0"
                                               Text="Soltex is idle. RustDesk remains the visible owner of any future session."
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="20" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,18,0,0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Permission boundary"
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontSize="21" />
                                    <TextBlock Margin="0,6,0,18"
                                               Text="A deliberately small bridge with visible stops."
                                               Foreground="{StaticResource MutedBrush}" />

                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="01" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource MonoFont}" FontSize="10" />
                                        <TextBlock Grid.Column="1" Text="Choose a local signed client" TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="02" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource MonoFont}" FontSize="10" />
                                        <TextBlock Grid.Column="1" Text="Confirm each Soltex launch" TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="03" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource MonoFont}" FontSize="10" />
                                        <TextBlock Grid.Column="1" Text="Authenticate and consent in RustDesk" TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="04" Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource MonoFont}" FontSize="10" />
                                        <TextBlock Grid.Column="1" Text="End and inspect the session there" TextWrapping="Wrap" />
                                    </Grid>

                                    <Border Margin="0,20,0,0"
                                            Background="{StaticResource InsetBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="13">
                                        <TextBlock Text="No bundled binary · no password flags · no elevation · no service install"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="UpdatePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="SOFTWARE DELIVERY" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="Updates"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="{StaticResource FontDisplay}" />
                        <TextBlock Margin="0,6,0,0"
                                   MaxWidth="700"
                                   Text="Inspect signed update-planning evidence before any future installer or elevation boundary exists."
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="14"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="UpdateInspectButton"
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            Style="{StaticResource SecondaryButton}"
                            Content="Inspect local state"
                            Click="UpdateInspect_Click" />
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border x:Name="UpdateReadinessHero"
                                Background="{StaticResource HeroPanelBrush}"
                                BorderBrush="{StaticResource HeroBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="24"
                                Padding="28">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="UpdateStateDot"
                                         Width="13"
                                         Height="13"
                                         Fill="{StaticResource SignalBrush}"
                                         VerticalAlignment="Top"
                                         Margin="0,8,0,0" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="UpdateStateTitle"
                                               Text="Planner state is clean"
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontSize="24" />
                                    <TextBlock x:Name="UpdateStateDetail"
                                               Margin="0,7,0,0"
                                               Text="No signed release source is configured, and no incomplete planning attempt is recorded."
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               LineHeight="21" />
                                </StackPanel>
                                <Border Grid.Column="3"
                                        VerticalAlignment="Top"
                                        Background="{StaticResource InsetBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="10,6">
                                    <TextBlock x:Name="UpdateStatePill"
                                               Text="IDLE"
                                               Foreground="{StaticResource SignalBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="9"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="18" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="18" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Prepared preview"
                                                           FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="22" />
                                                <TextBlock Margin="0,5,0,0"
                                                           Text="Exact file, hash, publisher, and disk-impact evidence appears here only after signed planning succeeds."
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock x:Name="UpdatePreviewStatus"
                                                       Grid.Column="1"
                                                       Margin="18,3,0,0"
                                                       Text="NO PREVIEW"
                                                       Foreground="{StaticResource WarningBrush}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="9" />
                                        </Grid>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="13" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Installed build" Foreground="{StaticResource QuietTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="9" />
                                                <TextBlock x:Name="CurrentBuildText" Margin="0,5,0,0" Text="Reading assembly" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Release channel" Foreground="{StaticResource QuietTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="9" />
                                                <TextBlock Margin="0,5,0,0" Text="Not configured" Foreground="{StaticResource WarningBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2">
                                                <TextBlock Text="Target release" Foreground="{StaticResource QuietTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="9" />
                                                <TextBlock Margin="0,5,0,0" Text="None prepared" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="1">
                                                <TextBlock Text="Plan and disk impact" Foreground="{StaticResource QuietTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="9" />
                                                <TextBlock Margin="0,5,0,0" Text="Not computed" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{StaticResource InsetBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="13">
                                                <TextBlock Text="A production release key, publisher pin, and signed descriptor source must be selected before planning can be enabled."
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                            <Button Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Stretch"
                                                    Style="{StaticResource ActionButton}"
                                                    Content="Plan update"
                                                    IsEnabled="False"
                                                    ToolTip="Unavailable until production signing identities and an authenticated release source are configured." />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Margin="0,18,0,0" Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="235" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Authenticated planning journal" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Text="Bounded phases and sanitized details; release URLs and local paths are never displayed."
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock x:Name="UpdateJournalCount"
                                                       Grid.Column="1"
                                                       Margin="16,0,0,0"
                                                       Text="0 entries"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <DataGrid x:Name="UpdateJournalGrid" Grid.Row="2" SelectionMode="Single">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="When" Binding="{Binding When}" Width="135" />
                                                <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="135" />
                                                <DataGridTemplateColumn Header="Detail" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Detail}"
                                                                       TextWrapping="Wrap"
                                                                       LineHeight="18"
                                                                       ToolTip="{Binding Detail}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource CardStyle}" Background="{StaticResource SignalSurfaceBrush}" BorderBrush="{StaticResource SignalBorderBrush}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PageEyebrowStyle}" Foreground="{StaticResource SignalBrush}" Text="NON-INSTALLING BOUNDARY" />
                                        <TextBlock Margin="0,12,0,0"
                                                   Text="Nothing installs from this page"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="21"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,8,0,18"
                                                   Text="The current component verifies and stages evidence, then stops at a human-readable preview."
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20" />
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="01" Foreground="{StaticResource SignalBrush}" FontFamily="{StaticResource MonoFont}" FontSize="10" />
                                            <TextBlock Grid.Column="1" Text="Signed metadata and quorum" TextWrapping="Wrap" />
                                        </Grid>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="02" Foreground="{StaticResource SignalBrush}" FontFamily="{StaticResource MonoFont}" FontSize="10" />
                                            <TextBlock Grid.Column="1" Text="Pinned HTTPS acquisition" TextWrapping="Wrap" />
                                        </Grid>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="03" Foreground="{StaticResource SignalBrush}" FontFamily="{StaticResource MonoFont}" FontSize="10" />
                                            <TextBlock Grid.Column="1" Text="Bounded private staging" TextWrapping="Wrap" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="04" Foreground="{StaticResource SignalBrush}" FontFamily="{StaticResource MonoFont}" FontSize="10" />
                                            <TextBlock Grid.Column="1" Text="Exact confirmation challenge" TextWrapping="Wrap" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,18,0,0" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Recovery review"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="21" />
                                        <TextBlock x:Name="UpdateRecoveryTitle"
                                                   Margin="0,12,0,0"
                                                   Text="No interrupted attempt"
                                                   Foreground="{StaticResource SignalBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="UpdateRecoveryDetail"
                                                   Margin="0,7,0,0"
                                                   Text="No private staging token requires review."
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20" />
                                        <Border Margin="0,18,0,0"
                                                Background="{StaticResource InsetBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="13">
                                            <TextBlock Text="No installer · no elevation · no service · no activation · no automatic rollback claim"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="2,16,2,4"
                                   Foreground="{StaticResource QuietTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="Scope: the update planner can authenticate, acquire, stage, verify, and preview a candidate. It does not install, elevate, activate, repair, uninstall, or silently recover a release." />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <views:MixerView x:Name="MixerPanel" Visibility="Collapsed" />

            <Grid x:Name="ClipsPanel" Visibility="Collapsed">
                <StackPanel>
                <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="CAPTURE / PREVIEW" />
                        <TextBlock Margin="0,7,0,0" Text="Capture" FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource FontDisplay}" />
                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Text="Capture is not installed yet. This preview keeps consent, storage, and performance boundaries visible." />
                    </StackPanel>
                </Border>
                    <Border Margin="0,18,0,0"
                            MaxWidth="640"
                            HorizontalAlignment="Left"
                            Style="{StaticResource HeroCardStyle}">
                        <StackPanel>
                            <TextBlock Text="CAPTURE OFF"
                                       Style="{StaticResource PageEyebrowStyle}"
                                       Foreground="{StaticResource WarningBrush}" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="Capture is not installed"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="28" />
                            <TextBlock Margin="0,9,0,0"
                                       MaxWidth="520"
                                       Text="A future Windows Graphics Capture implementation must remain opt-in, visibly active, locally stored, and performance-bounded."
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}"
                                       LineHeight="20" />
                            <TextBlock Margin="0,16,0,0"
                                       Text="No recorder · no overlay · no game injection"
                                       Foreground="{StaticResource QuietTextBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
