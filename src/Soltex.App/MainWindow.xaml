<Window x:Class="Soltex.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Soltex.App.Views"
        Title="Soltex"
        Width="1360"
        Height="860"
        MinWidth="860"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ShellBackdropBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid x:Name="ShellRoot" Background="{DynamicResource ShellBackdropBrush}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="NativeTitleBarRow" Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="NativeTitleBar"
                Grid.Row="0"
                Grid.ColumnSpan="2"
                Height="40"
                Background="{DynamicResource ShellTitleBarBrush}"
                BorderBrush="{DynamicResource TrackBrush}"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed"
                AutomationProperties.Name="Soltex window title bar">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NativeCaptionLeftInsetColumn" Width="0" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="13" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="NativeCaptionRightInsetColumn" Width="138" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1"
                           Margin="14,0,0,0"
                           Text="Soltex"
                           Foreground="{DynamicResource TextBrightBrush}"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="{StaticResource FontBody}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Border Grid.Column="2"
                        Width="1"
                        Height="14"
                        Background="{DynamicResource BorderBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                <TextBlock x:Name="NativeWorkspaceTitle"
                           Grid.Column="3"
                           Text="Overview"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontCaption}"
                           VerticalAlignment="Center" />
                <Grid x:Name="NativeTitleBarDragRegion"
                      Grid.Column="0"
                      Grid.ColumnSpan="4"
                      Background="{DynamicResource TransparentBrush}" />
            </Grid>
        </Border>

        <Border x:Name="NavigationRail"
                Grid.Row="1"
                Grid.Column="0"
                Background="{DynamicResource ShellNavigationBrush}"
                BorderBrush="{DynamicResource TrackBrush}"
                BorderThickness="0,0,1,0"
                TextElement.Foreground="{DynamicResource TextBrush}"
                TextElement.FontFamily="{StaticResource UiFont}">
            <Grid x:Name="NavigationRailContent" Margin="14,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" Background="{DynamicResource AccentQuietBrush}" BorderBrush="{DynamicResource AccentDimBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}">
                        <TextBlock Text="S" Foreground="{DynamicResource AccentFocusBrush}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel x:Name="BrandTextPanel" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Soltex" Foreground="{DynamicResource TextBrightBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel>
                    <TextBlock Tag="NavGroup" Margin="10,0,0,6" Text="System" Foreground="{DynamicResource QuietTextBrush}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" />
                    <Button x:Name="HomeNavButton" Tag="Selected" Style="{StaticResource NavButton}" AutomationProperties.Name="Overview" Click="HomeNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Tag="NavLabel" Text="Overview" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="MonitoringNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Performance" Click="MonitoringNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Tag="NavLabel" Text="Performance" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="ApplicationsNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Applications" Click="ApplicationsNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Tag="NavLabel" Text="Applications" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Grid>
                    </Button>
                    <TextBlock Tag="NavGroup" Margin="10,17,0,6" Text="Control" Foreground="{DynamicResource QuietTextBrush}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" />
                    <Button x:Name="MixerNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Audio" Click="MixerNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Tag="NavLabel" Text="Audio" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="SecurityNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Security" Click="SecurityNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Tag="NavLabel" Text="Security" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="WhisperNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Whisper dictation" Click="WhisperNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Tag="NavLabel" Text="Whisper" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="2" Tag="NavDetail" Margin="8,0,0,0" Text="SETUP" Foreground="{DynamicResource WarningBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" />
                        </Grid>
                    </Button>
                    <Button x:Name="RemoteNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Remote Assist" Click="RemoteNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8AF;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Tag="NavLabel" Text="Remote Assist" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Grid>
                    </Button>
                    <TextBlock Tag="NavGroup" Margin="10,17,0,6" Text="Maintain" Foreground="{DynamicResource QuietTextBrush}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" />
                    <Button x:Name="DevicesNavButton" Visibility="Collapsed" Style="{StaticResource NavButton}" AutomationProperties.Name="Device mesh preview" Click="DevicesNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE772;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Tag="NavLabel" Text="Device mesh" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="2" Tag="NavDetail" Margin="8,0,0,0" Text="PREVIEW" Foreground="{DynamicResource WarningBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" />
                        </Grid>
                    </Button>
                    <Button x:Name="ClipsNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Capture" Click="ClipsNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Tag="NavLabel" Text="Capture" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="ActivityNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Activity" Click="ActivityNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Tag="NavLabel" Text="Activity" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="UpdateNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Updates" Click="UpdateNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Tag="NavLabel" Text="Updates" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Grid>
                    </Button>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="3">
                    <Button x:Name="CommandPaletteButton"
                            Margin="0,0,0,8"
                            Style="{StaticResource NavButton}"
                            AutomationProperties.Name="Open command palette"
                            Click="CommandPaletteButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Tag="NavLabel" Text="Find a tool" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="2" Tag="NavDetail" Text="Ctrl+K" Foreground="{DynamicResource QuietTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" />
                        </Grid>
                    </Button>
                    <Button x:Name="SettingsNavButton"
                            Margin="0,0,0,10"
                            Style="{StaticResource NavButton}"
                            AutomationProperties.Name="Settings"
                            Click="SettingsNav_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            <TextBlock Grid.Column="1" Tag="NavLabel" Text="Settings" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                        </Grid>
                    </Button>
                    <Border x:Name="ProtectionSummaryBorder"
                            Background="{DynamicResource QuietBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}"
                            Padding="11">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Ellipse x:Name="ProtectionSummaryDot" Width="7" Height="7" Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ProtectionSummaryTitle" Grid.Column="1" Margin="8,0,0,0" Text="Protection status" FontWeight="SemiBold" />
                                <TextBlock x:Name="ProtectionSummaryState" Grid.Column="2" Text="CHECKING" Foreground="{DynamicResource MutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" />
                            </Grid>
                            <TextBlock x:Name="ProtectionSummaryDetail" Margin="15,5,0,0" Text="Reading Windows Security" Foreground="{DynamicResource MutedBrush}" FontSize="{StaticResource FontCaption}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Grid x:Name="NavigationFooter" Margin="3,10,3,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Local workspace" Foreground="{DynamicResource QuietTextBrush}" FontSize="{StaticResource FontCaption}" />
                        <TextBlock x:Name="ShellBuildText" Grid.Column="1" Text="1.0.0" Foreground="{DynamicResource QuietTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceHost"
              Grid.Row="1"
              Grid.Column="1"
              Margin="28,22,28,24"
              ClipToBounds="True"
              TextElement.Foreground="{DynamicResource TextBrush}"
              TextElement.FontFamily="{StaticResource UiFont}">
            <views:HomeView x:Name="HomePanel" />
            <views:MonitoringView x:Name="MonitoringPanel" Visibility="Collapsed" />
            <views:ApplicationsView x:Name="ApplicationsPanel" Visibility="Collapsed" />
            <views:ActivityView x:Name="ActivityPanel" Visibility="Collapsed" />
            <views:SettingsView x:Name="SettingsPanel" Visibility="Collapsed" />
            <views:DevicesView x:Name="DevicesPanel" Visibility="Collapsed" />
            <views:WhisperView x:Name="WhisperPanel" Visibility="Collapsed" />

            <Grid x:Name="SecurityPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Security" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="Windows protection, scans, and quarantine." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Margin="0,0,10,0" Style="{StaticResource StatusPillStyle}"
                                ToolTip="Windows Security or your registered antivirus app supplies system-wide real-time protection.">
                            <TextBlock Text="System protection" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontCaption}" />
                        </Border>
                        <Button Style="{StaticResource SecondaryButton}"
                                Content="Open Windows Security"
                                Click="OpenWindowsSecurity_Click" />
                    </StackPanel>
                </Grid>

                <Border x:Name="HealthHero"
                        Grid.Row="2"
                        Background="{DynamicResource SignalSurfaceBrush}"
                        BorderBrush="{DynamicResource SignalBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusCard}"
                        Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="HealthDot" Width="10" Height="10" Fill="{DynamicResource SignalBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="HealthTitle" Text="Checking Windows protection…" FontSize="{StaticResource FontSection}" FontWeight="SemiBold" />
                            <TextBlock x:Name="HealthDetail"
                                       Margin="0,3,0,0"
                                       Text="Reading supported Windows Security and Defender status."
                                       Foreground="{DynamicResource SignalTextBrush}"
                                       FontSize="{StaticResource FontCaption}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <ProgressBar x:Name="BusyProgress" Width="72" Height="4" Margin="0,0,10,0" IsIndeterminate="True" Visibility="Collapsed" />
                            <Button x:Name="RefreshButton" Style="{StaticResource SecondaryButton}" Content="Refresh" Click="Refresh_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource WorkbenchStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="12,9">
                            <TextBlock Text="Real-time" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock x:Name="RealTimeStatus" Margin="0,3,0,0" Text="Checking" FontWeight="SemiBold" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />
                        <StackPanel Grid.Column="2" Margin="12,9">
                            <TextBlock Text="Behavior" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock x:Name="BehaviorStatus" Margin="0,3,0,0" Text="Checking" FontWeight="SemiBold" />
                        </StackPanel>
                        <Border Grid.Column="3" Background="{DynamicResource BorderBrush}" />
                        <StackPanel Grid.Column="4" Margin="12,9">
                            <TextBlock Text="Cloud" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock x:Name="CloudStatus" Margin="0,3,0,0" Text="Checking" FontWeight="SemiBold" />
                        </StackPanel>
                        <Border Grid.Column="5" Background="{DynamicResource BorderBrush}" />
                        <StackPanel Grid.Column="6" Margin="12,9">
                            <TextBlock Text="Intelligence" Style="{StaticResource MutedTextStyle}" />
                            <TextBlock x:Name="SignatureStatus" Margin="0,3,0,0" Text="Checking" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="6"
                        Background="{DynamicResource QuietBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusCard}"
                        Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Scan" Margin="2,0,16,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="QuickScanButton" Margin="0,0,8,0" Style="{StaticResource ActionButton}" Content="Quick scan" Click="QuickScan_Click" />
                            <Button x:Name="FileScanButton" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Content="File" Click="FileScan_Click" />
                            <Button x:Name="FolderScanButton" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Content="Folder" Click="FolderScan_Click" />
                            <Button x:Name="UpdateButton" Style="{StaticResource SecondaryButton}" Content="Update intelligence" Click="Update_Click" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="EventQueryStatus" Margin="0,0,10,0" Text="Checking" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                            <Button x:Name="SecurityActivityButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Windows events"
                                    AutomationProperties.Name="Show recent Windows protection activity"
                                    Click="SecurityActivity_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="8" Style="{StaticResource WorkbenchStyle}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="DefenderEventGrid"
                                  Height="180"
                                  Margin="0,0,0,10"
                                  Visibility="Collapsed"
                                  SelectionMode="Single"
                                  AutomationProperties.Name="Recent Windows protection activity">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="When" Binding="{Binding When}" Width="125" />
                                <DataGridTextColumn Header="Level" Binding="{Binding Severity}" Width="85" />
                                <DataGridTextColumn Header="Event" Binding="{Binding Title}" Width="190" />
                                <DataGridTemplateColumn Header="Detail" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" LineHeight="18" ToolTip="{Binding Detail}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid Margin="0,0,12,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Quarantine" />
                                    <TextBlock x:Name="QuarantineCount" Grid.Column="1" Text="0 items" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <DataGrid x:Name="QuarantineGrid"
                                          Grid.Row="2"
                                          SelectionMode="Single"
                                          AutomationProperties.Name="Quarantined local files">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" />
                                        <DataGridTextColumn Header="Detection" Binding="{Binding Detection}" Width="2*" />
                                        <DataGridTextColumn Header="When" Binding="{Binding When}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Content="Restore" Click="Restore_Click" />
                                    <Button Style="{StaticResource SecondaryButton}" Foreground="{DynamicResource DangerTextBrush}" Content="Delete" Click="Delete_Click" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />
                            <Grid Grid.Column="2" Margin="12,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Soltex activity" />
                                <ListBox x:Name="ActivityList"
                                         Grid.Row="2"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextBrush}"
                                         FontSize="{StaticResource FontCaption}"
                                         AutomationProperties.Name="Recent Soltex security activity"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,2,8,7"
                                                       Text="{Binding}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="18" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Grid.Row="4" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Content="Protected imports" Click="OpenImports_Click" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="RemotePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Remote Assist" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedTextStyle}" Text="Use your installed RustDesk client." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Margin="0,0,10,0" Style="{StaticResource StatusPillStyle}"
                                ToolTip="Soltex launches only the client you select. It does not install RustDesk.">
                            <TextBlock Text="RustDesk" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontCaption}" />
                        </Border>
                        <Button Style="{StaticResource SecondaryButton}" Content="Source &amp; license" Click="OpenRustDeskSource_Click" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        Background="{DynamicResource QuietBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusCard}"
                        Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="RemoteTrustDot" Width="10" Height="10" Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="RemoteTrustState" Text="RustDesk is not connected" FontSize="{StaticResource FontSection}" FontWeight="SemiBold" />
                            <TextBlock x:Name="RemoteTrustDetail" Margin="0,3,0,0" Text="Choose an installed, signed RustDesk.exe." Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="3" Style="{StaticResource StatusPillStyle}" VerticalAlignment="Center">
                            <TextBlock x:Name="RemoteTrustPill" Text="NOT CONNECTED" Foreground="{DynamicResource WarningBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource WorkbenchStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Client" />
                            <Border Grid.Row="2" Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Selected executable" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock x:Name="RemoteExecutablePath" Margin="0,6,0,0" Text="No external client selected" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMono}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="RemoteFingerprint" Margin="0,7,0,0" Text="SHA-256 unavailable" Foreground="{DynamicResource QuietTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Row="4" Orientation="Horizontal">
                                <Button Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Content="Choose RustDesk.exe" Click="SelectRustDesk_Click" />
                                <Button x:Name="RemoteShareButton" Style="{StaticResource ActionButton}" Content="Open sharing" IsEnabled="False" Click="ShareRemote_Click" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

                        <Grid Grid.Column="2" Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Connect to a peer" />
                            <TextBlock x:Name="RemoteSessionStatus"
                                       Grid.Row="2"
                                       Text="No launch requested"
                                       Foreground="{DynamicResource SignalBrush}"
                                       FontWeight="SemiBold"
                                       AutomationProperties.Name="Remote Assist session status"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="RemoteSessionDetail" Grid.Row="4" Text="RustDesk remains the visible owner of any session." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                            <TextBox x:Name="RemotePeerIdInput"
                                     Grid.Row="6"
                                     Style="{StaticResource FieldStyle}"
                                     MaxLength="64"
                                     ToolTip="RustDesk peer ID"
                                     AutomationProperties.Name="RustDesk peer ID" />
                            <Grid Grid.Row="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="RemotePeerHint" Text="3–64 letters, numbers, hyphens, or underscores" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                                <Button x:Name="RemoteConnectButton" Grid.Column="1" Margin="14,0,0,0" Style="{StaticResource ActionButton}" Content="Connect" IsEnabled="False" Click="ConnectRemote_Click" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="6" Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="10">
                    <TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="{StaticResource FontCaption}"
                               Text="Soltex asks before launch. RustDesk handles authentication and session controls." />
                </Border>
            </Grid>

            <Grid x:Name="UpdatePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Updates" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedTextStyle}" Text="Review the installed version and update readiness." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Margin="0,0,10,0" Style="{StaticResource StatusPillStyle}"
                                 ToolTip="Soltex checks update readiness in this build. It does not install anything.">
                            <TextBlock Text="Preview only" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontCaption}" />
                        </Border>
                        <Button x:Name="UpdateInspectButton" Style="{StaticResource SecondaryButton}" Content="Inspect local state" Click="UpdateInspect_Click" />
                    </StackPanel>
                </Grid>

                <Border x:Name="UpdateReadinessHero"
                        Grid.Row="2"
                        Background="{DynamicResource QuietBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusCard}"
                        Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="UpdateStateDot" Width="10" Height="10" Fill="{DynamicResource SignalBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateStateTitle" Text="Planner state is clean" FontSize="{StaticResource FontSection}" FontWeight="SemiBold" />
                            <TextBlock x:Name="UpdateStateDetail" Margin="0,3,0,0" Text="No signed release source or incomplete attempt is recorded." Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="3" Style="{StaticResource StatusPillStyle}" VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateStatePill" Text="IDLE" Foreground="{DynamicResource SignalBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="UpdatePreviewTab" Tag="Selected" Style="{StaticResource TabButtonStyle}" Content="Preview" AutomationProperties.Name="Show update preview" Click="UpdatePreviewTab_Click" />
                        <Button x:Name="UpdateJournalTab" Margin="8,0,0,0" Style="{StaticResource TabButtonStyle}" Content="History" AutomationProperties.Name="Show update history" Click="UpdateJournalTab_Click" />
                        <Button x:Name="UpdateRecoveryTab" Margin="8,0,0,0" Style="{StaticResource TabButtonStyle}" Content="Recovery" AutomationProperties.Name="Show update recovery review" Click="UpdateRecoveryTab_Click" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="6" Style="{StaticResource WorkbenchStyle}">
                    <Grid>
                        <Grid x:Name="UpdatePreviewPanel" Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Update preview" />
                                <TextBlock x:Name="UpdatePreviewStatus" Grid.Column="1" Text="NO PREVIEW" Foreground="{DynamicResource WarningBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel Margin="0,0,16,14">
                                    <TextBlock Text="Installed build" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock x:Name="CurrentBuildText" Margin="0,5,0,0" Text="Reading assembly" />
                                </StackPanel>
                                <Border Grid.Column="1" Grid.RowSpan="3" Background="{DynamicResource BorderBrush}" />
                                <StackPanel Grid.Column="2" Margin="16,0,0,14">
                                    <TextBlock Text="Release channel" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Margin="0,5,0,0" Text="Not configured" Foreground="{DynamicResource WarningBrush}" />
                                </StackPanel>
                                <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource BorderBrush}" />
                                <StackPanel Grid.Row="2" Margin="0,14,16,0">
                                    <TextBlock Text="Target release" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Margin="0,5,0,0" Text="None prepared" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="16,14,0,0">
                                    <TextBlock Text="Plan and disk impact" Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Margin="0,5,0,0" Text="Not computed" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="12">
                                    <TextBlock Text="Automatic updates are not configured for this build." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                </Border>
                                <Button Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource ActionButton}" Content="Plan update" IsEnabled="False" ToolTip="Available after a signed release channel is configured." />
                            </Grid>
                        </Grid>

                        <Grid x:Name="UpdateJournalPanel" Margin="18" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Update history" />
                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedTextStyle}" Text="URLs and local file paths are not saved." />
                                </StackPanel>
                                <TextBlock x:Name="UpdateJournalCount" Grid.Column="1" Text="0 entries" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <DataGrid x:Name="UpdateJournalGrid"
                                      Grid.Row="2"
                                      SelectionMode="Single"
                                      AutomationProperties.Name="Update history">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="When" Binding="{Binding When}" Width="135" />
                                    <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="135" />
                                    <DataGridTemplateColumn Header="Detail" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" LineHeight="18" ToolTip="{Binding Detail}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Grid x:Name="UpdateRecoveryPanel" Margin="18" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Recovery review" />
                            <StackPanel Grid.Row="2">
                                <TextBlock x:Name="UpdateRecoveryTitle" Text="No interrupted attempt" Foreground="{DynamicResource SignalBrush}" FontWeight="SemiBold" />
                            <TextBlock x:Name="UpdateRecoveryDetail" Margin="0,5,0,0" Text="No unfinished update needs attention." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Row="4" Background="{DynamicResource SignalSurfaceBrush}" BorderBrush="{DynamicResource SignalBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="Your confirmation is required" />
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedTextStyle}" Text="Soltex verifies an update before presenting it." />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontCaption}" Text="Preview only" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <views:MixerView x:Name="MixerPanel" Visibility="Collapsed" />

            <views:CaptureView x:Name="CapturePanel" Visibility="Collapsed" />
        </Grid>

        <Grid x:Name="OnboardingOverlay"
              Grid.RowSpan="2"
              Grid.ColumnSpan="2"
              Panel.ZIndex="110"
              Background="{DynamicResource ModalScrimBrush}"
              Visibility="Collapsed"
              AutomationProperties.Name="Soltex first-run setup"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle">
            <Border Margin="24"
                    MaxWidth="920"
                    MaxHeight="720"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ElevatedBrush}"
                    BorderBrush="{DynamicResource AccentDimBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="24">
                <views:OnboardingView x:Name="OnboardingPanel" />
            </Border>
        </Grid>

        <Grid x:Name="CommandPaletteOverlay"
              Grid.RowSpan="2"
              Grid.ColumnSpan="2"
              Panel.ZIndex="100"
              Background="{DynamicResource ModalScrimBrush}"
              Visibility="Collapsed"
              AutomationProperties.Name="Command palette"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle"
              MouseLeftButtonDown="CommandPaletteOverlay_MouseLeftButtonDown">
            <Border Width="620"
                    MaxHeight="640"
                    Margin="0,86,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{DynamicResource ElevatedBrush}"
                    BorderBrush="{DynamicResource AccentDimBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLg}"
                    Padding="18"
                    MouseLeftButtonDown="CommandPaletteSurface_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource AccentFocusBrush}" VerticalAlignment="Center" />
                        <TextBox x:Name="CommandSearchBox"
                                 Grid.Column="1"
                                 Margin="12,0,0,0"
                                 Style="{StaticResource FieldStyle}"
                                 FontSize="16"
                                 AutomationProperties.Name="Find a Soltex tool"
                                 TextChanged="CommandSearchBox_TextChanged"
                                 PreviewKeyDown="CommandSearchBox_PreviewKeyDown" />
                    </Grid>
                    <ListBox x:Name="CommandPaletteList"
                             Grid.Row="2"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="460"
                             ItemContainerStyle="{StaticResource CommandPaletteItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Soltex tools"
                             PreviewKeyDown="CommandPaletteList_PreviewKeyDown"
                             MouseLeftButtonUp="CommandPaletteList_MouseLeftButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrightBrush}" />
                                        <TextBlock Margin="0,3,0,0" Text="{Binding Group}" Foreground="{DynamicResource QuietTextBrush}" FontSize="{StaticResource FontCaption}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Shortcut}" Foreground="{DynamicResource QuietTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="CommandEmptyText"
                               Grid.Row="2"
                               Margin="8,18"
                               Text="No matching Soltex tool"
                               Foreground="{DynamicResource MutedBrush}"
                               AutomationProperties.LiveSetting="Polite"
                               Visibility="Collapsed" />
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Type to filter · Enter to open" Foreground="{DynamicResource QuietTextBrush}" FontSize="{StaticResource FontCaption}" />
                        <TextBlock Grid.Column="1" Text="Esc to close" Foreground="{DynamicResource QuietTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
