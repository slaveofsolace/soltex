<Window x:Class="Soltex.App.WhisperOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Soltex Whisper"
        Width="352"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        AutomationProperties.Name="Whisper listening surface">

    <Border Style="{StaticResource WhisperOverlayShellStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The only element that carries state colour. -->
            <Border x:Name="StateRail" Grid.RowSpan="2" Style="{StaticResource WhisperStateRailStyle}" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="HeadlineText"
                           Text="Listening"
                           FontWeight="SemiBold"
                           AutomationProperties.LiveSetting="Assertive" />
                <TextBlock x:Name="TargetText"
                           Margin="0,2,0,0"
                           Text="Unknown target"
                           Style="{StaticResource MutedTextStyle}"
                           FontSize="{StaticResource FontCaption}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <TextBlock x:Name="ElapsedText"
                       Grid.Column="2"
                       Margin="10,0,10,0"
                       VerticalAlignment="Center"
                       Text="0:00"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="{StaticResource FontMono}"
                       AutomationProperties.Name="Elapsed dictation time" />

            <Button x:Name="OverlayActionButton"
                    Grid.Column="3"
                    Style="{StaticResource SecondaryButton}"
                    Padding="10,5"
                    FontSize="{StaticResource FontCaption}"
                    Content="Cancel"
                    AutomationProperties.Name="Cancel dictation"
                    Click="OverlayAction_Click" />

            <ProgressBar x:Name="LevelMeter"
                         Grid.Row="1"
                         Grid.Column="1"
                         Grid.ColumnSpan="3"
                         Margin="0,8,0,0"
                         Style="{StaticResource WhisperLevelMeterStyle}"
                         Value="0"
                         AutomationProperties.Name="Microphone input level" />
        </Grid>
    </Border>
</Window>
