<UserControl x:Class="Soltex.App.Views.WhisperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>

        <!-- One readiness prerequisite: state dot, name, one sentence, one action. -->
        <DataTemplate x:Key="ReadinessRowTemplate">
            <Border Style="{StaticResource WhisperChecklistRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8"
                             Height="8"
                             Margin="2,0,10,0"
                             VerticalAlignment="Center"
                             Fill="{Binding StateBrush}" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Text="{Binding Title}"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Text="{Binding Detail}"
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Column="3"
                               VerticalAlignment="Center"
                               Text="{Binding StateLabel}"
                               Foreground="{Binding StateBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource FontMicro}"
                               FontWeight="SemiBold" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A shortcut chord rendered as the keys the user actually presses. -->
        <DataTemplate x:Key="KeycapTemplate">
            <Border Style="{StaticResource WhisperKeycapStyle}">
                <TextBlock Style="{StaticResource WhisperKeycapTextStyle}" Text="{Binding}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ShortcutRowTemplate">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{Binding Action}" />
                <ItemsControl Grid.Column="1"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Keys}"
                              ItemTemplate="{StaticResource KeycapTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Grid.Column="2"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding Description}"
                           Style="{StaticResource MutedTextStyle}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="VocabularyRowTemplate">
            <Border Margin="0,0,0,6"
                    Background="{StaticResource InsetBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}"
                    Padding="10,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding Term}"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1"
                            Margin="12,0,0,0"
                            Padding="8,3"
                            Style="{StaticResource SecondaryButton}"
                            Content="Remove"
                            AutomationProperties.Name="{Binding RemoveAutomationName}"
                            Click="RemoveVocabulary_Click" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SnippetRowTemplate">
            <Border Margin="0,0,0,8" Style="{StaticResource QuietCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Cue}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0"
                                   MaxHeight="42"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="{Binding Preview}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButton}"
                            Content="Remove"
                            AutomationProperties.Name="{Binding RemoveAutomationName}"
                            Click="RemoveSnippet_Click" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CustomStyleRowTemplate">
            <Border Margin="0,0,0,8" Style="{StaticResource QuietCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="{Binding Summary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButton}"
                            Content="Remove"
                            AutomationProperties.Name="{Binding RemoveAutomationName}"
                            Click="RemoveCustomStyle_Click" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ApplicationProfileRowTemplate">
            <Border Margin="0,0,0,8" Style="{StaticResource QuietCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="{Binding Summary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButton}"
                            Content="Remove"
                            AutomationProperties.Name="{Binding RemoveAutomationName}"
                            Click="RemoveApplicationProfile_Click" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ScratchpadTabTemplate">
            <Border Margin="0,0,8,0"
                    Background="{StaticResource InsetBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource TabButtonStyle}"
                            Content="{Binding Title}"
                            Tag="{Binding SelectionTag}"
                            AutomationProperties.Name="{Binding OpenAutomationName}"
                            Click="ActivateScratchpadTab_Click" />
                    <Button MinWidth="30"
                            Padding="7,4"
                            Style="{StaticResource SecondaryButton}"
                            Content="×"
                            AutomationProperties.Name="{Binding CloseAutomationName}"
                            Click="CloseScratchpadTab_Click" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Command header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Whisper" />
                <TextBlock Margin="0,3,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Hold a shortcut, speak, and Whisper inserts cleaned text into the focused field." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="WhisperScaffoldPill"
                        Margin="0,0,10,0"
                        Style="{StaticResource StatusPillStyle}"
                        ToolTip="Native microphone capture and the validated shortcut lifecycle are available. Provider-backed transcription and shipped delivery are still being implemented.">
                    <TextBlock Text="Scaffold"
                               Foreground="{StaticResource WarningBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource FontMicro}"
                               FontWeight="SemiBold" />
                </Border>
                <Button x:Name="WhisperPreviewOverlayButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="Preview listening surface"
                        AutomationProperties.Name="Preview the Whisper listening surface"
                        Click="PreviewOverlay_Click" />
            </StackPanel>
        </Grid>

        <!-- Readiness summary -->
        <Border x:Name="WhisperReadinessHero" Grid.Row="2" Style="{StaticResource HeroCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="WhisperReadinessDot"
                         Width="10"
                         Height="10"
                         VerticalAlignment="Center"
                         Fill="{StaticResource WarningBrush}" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="WhisperReadinessTitle"
                               Text="Whisper is not ready"
                               FontSize="{StaticResource FontSection}"
                               FontWeight="SemiBold"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="WhisperReadinessDetail"
                               Margin="0,3,0,0"
                               Text="Checking prerequisites."
                               Style="{StaticResource MutedTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock x:Name="WhisperReadinessAction"
                           Grid.Column="3"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Text=""
                           Foreground="{StaticResource WarningBrush}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="{StaticResource FontMicro}" />
            </Grid>
        </Border>

        <!-- Local switcher -->
        <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <WrapPanel>
                <Button x:Name="WhisperSetupTab"
                        Tag="Selected"
                        Style="{StaticResource TabButtonStyle}"
                        Content="Setup"
                        AutomationProperties.Name="Show Whisper setup"
                        Click="WhisperSetupTab_Click" />
                <Button x:Name="WhisperShortcutsTab"
                        Margin="8,0,0,0"
                        Style="{StaticResource TabButtonStyle}"
                        Content="Shortcuts"
                        AutomationProperties.Name="Show Whisper shortcuts"
                        Click="WhisperShortcutsTab_Click" />
                <Button x:Name="WhisperPersonalizeTab"
                        Margin="8,0,0,0"
                        Style="{StaticResource TabButtonStyle}"
                        Content="Personalize"
                        AutomationProperties.Name="Show Whisper personalization"
                        Click="WhisperPersonalizeTab_Click" />
                <Button x:Name="WhisperLibraryTab"
                        Margin="8,0,0,0"
                        Style="{StaticResource TabButtonStyle}"
                        Content="Library"
                        AutomationProperties.Name="Show Whisper snippets styles and application rules"
                        Click="WhisperLibraryTab_Click" />
                <Button x:Name="WhisperScratchpadTab"
                        Margin="8,0,0,0"
                        Style="{StaticResource TabButtonStyle}"
                        Content="Scratchpad"
                        AutomationProperties.Name="Show Whisper Scratchpad"
                        Click="WhisperScratchpadTab_Click" />
                <Button x:Name="WhisperPrivacyTab"
                        Margin="8,0,0,0"
                        Style="{StaticResource TabButtonStyle}"
                        Content="Privacy"
                        AutomationProperties.Name="Show Whisper privacy boundaries"
                        Click="WhisperPrivacyTab_Click" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource WorkbenchStyle}">
            <Grid>

                <!-- Setup: the readiness checklist owns this surface. -->
                <Grid x:Name="WhisperSetupPanel" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Before you can dictate" />
                            <TextBlock Margin="0,3,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="Each row is one prerequisite and the single action that resolves it." />
                        </StackPanel>
                        <TextBlock x:Name="WhisperReadinessCount"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="0 ready"
                                   Foreground="{StaticResource MutedBrush}" />
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource QuietCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Whisper runtime" FontWeight="SemiBold" />
                                <TextBlock x:Name="WhisperFeatureStatus"
                                           Margin="0,3,12,0"
                                           Text="Whisper is off. No global shortcuts are registered."
                                           Style="{StaticResource MutedTextStyle}"
                                           AutomationProperties.LiveSetting="Polite"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="WhisperFeatureToggleButton"
                                    Grid.Column="1"
                                    MinWidth="92"
                                    Style="{StaticResource ActionButton}"
                                    Content="Turn on"
                                    AutomationProperties.Name="Turn Whisper on"
                                    Click="FeatureToggle_Click" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="4" Style="{StaticResource QuietCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Microphone" FontWeight="SemiBold" />
                                <TextBlock x:Name="WhisperCaptureStatus"
                                           Margin="0,3,0,0"
                                           Text="Checking Windows input devices."
                                           Style="{StaticResource MutedTextStyle}"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <Button x:Name="WhisperRefreshDevicesButton"
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Refresh"
                                    AutomationProperties.Name="Refresh Whisper microphone devices"
                                    Click="RefreshDevices_Click" />
                            <Button x:Name="WhisperMicrophoneTestButton"
                                    Grid.Column="3"
                                    Style="{StaticResource ActionButton}"
                                    Content="Test microphone"
                                    IsEnabled="False"
                                    AutomationProperties.Name="Start a five second microphone test"
                                    Click="MicrophoneTest_Click" />
                            <ComboBox x:Name="WhisperInputDevicePicker"
                                      Grid.Row="2"
                                      Grid.ColumnSpan="4"
                                      MinWidth="320"
                                      HorizontalAlignment="Stretch"
                                      Style="{StaticResource SoltexComboBoxStyle}"
                                      DisplayMemberPath="DisplayName"
                                      AutomationProperties.Name="Whisper input device"
                                      SelectionChanged="InputDevicePicker_SelectionChanged" />
                        </Grid>
                    </Border>
                    <ItemsControl x:Name="WhisperReadinessList"
                                  Grid.Row="6"
                                  ItemTemplate="{StaticResource ReadinessRowTemplate}"
                                  AutomationProperties.Name="Whisper readiness checks"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Grid>

                <!-- Shortcuts -->
                <Grid x:Name="WhisperShortcutsPanel" Margin="18" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Default shortcuts" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="Up to four chords per action and three keys per chord, including Mouse 4 and Mouse 5." />
                    </StackPanel>
                    <ItemsControl x:Name="WhisperShortcutList"
                                  Grid.Row="2"
                                  ItemTemplate="{StaticResource ShortcutRowTemplate}"
                                  AutomationProperties.Name="Whisper default shortcuts"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    <Border Grid.Row="3"
                            Background="{StaticResource InsetBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="10">
                        <TextBlock x:Name="WhisperShortcutStatus"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="Whisper is off, so no global shortcut is registered." />
                    </Border>
                </Grid>

                <!-- Personalization: provider hints and deterministic style settings. -->
                <ScrollViewer x:Name="WhisperPersonalizePanel"
                              Margin="18"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="Personalization" />
                        <TextBlock Margin="0,3,0,12"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   Text="These settings shape recognition and formatting. Vocabulary is sent as provider hints and is never substituted into a finished transcript." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource QuietCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Language" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,8"
                                               Style="{StaticResource MutedTextStyle}"
                                               Text="Auto-detect keeps mixed-language speech available to the provider." />
                                    <ComboBox x:Name="WhisperLanguagePicker"
                                              Style="{StaticResource SoltexComboBoxStyle}"
                                              DisplayMemberPath="DisplayName"
                                              AutomationProperties.Name="Whisper language"
                                              SelectionChanged="PersonalizationPicker_SelectionChanged" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource QuietCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Default style" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,8"
                                               Style="{StaticResource MutedTextStyle}"
                                               Text="A terminal target still forces the literal terminal style." />
                                    <ComboBox x:Name="WhisperStylePicker"
                                              Style="{StaticResource SoltexComboBoxStyle}"
                                              DisplayMemberPath="DisplayName"
                                              AutomationProperties.Name="Whisper default style"
                                              SelectionChanged="PersonalizationPicker_SelectionChanged" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Margin="0,12,0,0" Style="{StaticResource QuietCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Personal vocabulary" FontWeight="SemiBold" />
                                    <TextBlock x:Name="WhisperVocabularyCount"
                                               Margin="0,3,0,0"
                                               Style="{StaticResource MutedTextStyle}"
                                               Text="0 of 512 terms" />
                                </StackPanel>
                                <TextBlock x:Name="WhisperPersonalizationStatus"
                                           Grid.Column="1"
                                           MaxWidth="420"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="Saved locally for this Windows account."
                                           TextTrimming="CharacterEllipsis"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBox x:Name="WhisperVocabularyInput"
                                         Grid.Row="2"
                                         MaxLength="64"
                                         Style="{StaticResource FieldStyle}"
                                         AutomationProperties.Name="New Whisper vocabulary term" />
                                <Button x:Name="WhisperVocabularyAddButton"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        MinWidth="76"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource ActionButton}"
                                        Content="Add term"
                                        AutomationProperties.Name="Add vocabulary term"
                                        Click="AddVocabulary_Click" />
                                <ListBox x:Name="WhisperVocabularyList"
                                         Grid.Row="4"
                                         Grid.ColumnSpan="2"
                                         MaxHeight="220"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemTemplate="{StaticResource VocabularyRowTemplate}"
                                         AutomationProperties.Name="Personal vocabulary"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Library: one editor at a time keeps dense rules understandable. -->
                <ScrollViewer x:Name="WhisperLibraryPanel"
                              Margin="18"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="Personal library" />
                                <TextBlock Margin="0,3,0,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="Reusable text and app-specific rules, stored only for this Windows account." />
                            </StackPanel>
                            <TextBlock x:Name="WhisperLibraryStatus"
                                       Grid.Column="1"
                                       MaxWidth="420"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="Saved locally for this Windows account."
                                       TextTrimming="CharacterEllipsis"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Grid>

                        <WrapPanel Margin="0,14,0,14">
                            <Button x:Name="WhisperSnippetsSectionTab"
                                    Tag="Selected"
                                    Style="{StaticResource TabButtonStyle}"
                                    Content="Snippets"
                                    AutomationProperties.Name="Edit Whisper snippets"
                                    Click="WhisperSnippetsSectionTab_Click" />
                            <Button x:Name="WhisperStylesSectionTab"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource TabButtonStyle}"
                                    Content="Styles"
                                    AutomationProperties.Name="Edit Whisper custom styles"
                                    Click="WhisperStylesSectionTab_Click" />
                            <Button x:Name="WhisperApplicationsSectionTab"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource TabButtonStyle}"
                                    Content="App rules"
                                    AutomationProperties.Name="Edit Whisper application rules"
                                    Click="WhisperApplicationsSectionTab_Click" />
                        </WrapPanel>

                        <StackPanel x:Name="WhisperSnippetsSection">
                            <Border Style="{StaticResource QuietCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="New snippet" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Text="Say the exact cue to insert the saved text." />
                                        </StackPanel>
                                        <TextBlock x:Name="WhisperSnippetCount"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Text="0 of 64" />
                                    </Grid>
                                    <TextBlock Margin="0,12,0,5" Text="Spoken cue" />
                                    <TextBox x:Name="WhisperSnippetCueInput"
                                             MaxLength="80"
                                             Style="{StaticResource FieldStyle}"
                                             AutomationProperties.Name="New snippet spoken cue" />
                                    <TextBlock Margin="0,10,0,5" Text="Text to insert" />
                                    <TextBox x:Name="WhisperSnippetContentInput"
                                             MinHeight="96"
                                             MaxHeight="180"
                                             MaxLength="4000"
                                             Style="{StaticResource FieldStyle}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="New snippet content" />
                                    <Button x:Name="WhisperSnippetAddButton"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource ActionButton}"
                                            Content="Save snippet"
                                            AutomationProperties.Name="Save new Whisper snippet"
                                            Click="AddSnippet_Click" />
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="WhisperSnippetList"
                                          Margin="0,12,0,0"
                                          ItemTemplate="{StaticResource SnippetRowTemplate}"
                                          AutomationProperties.Name="Saved Whisper snippets" />
                        </StackPanel>

                        <StackPanel x:Name="WhisperStylesSection" Visibility="Collapsed">
                            <Border Style="{StaticResource QuietCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="New style" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Text="Start from visible, deterministic formatting rules." />
                                        </StackPanel>
                                        <TextBlock x:Name="WhisperCustomStyleCount"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Text="0 of 16" />
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,5" Text="Style name" />
                                            <TextBox x:Name="WhisperCustomStyleNameInput"
                                                     MaxLength="64"
                                                     Style="{StaticResource FieldStyle}"
                                                     AutomationProperties.Name="New custom style name" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Margin="0,0,0,5" Text="Formatting rules" />
                                            <ComboBox x:Name="WhisperCustomStyleBasePicker"
                                                      Style="{StaticResource SoltexComboBoxStyle}"
                                                      DisplayMemberPath="DisplayName"
                                                      AutomationProperties.Name="Custom style formatting rules" />
                                        </StackPanel>
                                    </Grid>
                                    <Button x:Name="WhisperCustomStyleAddButton"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource ActionButton}"
                                            Content="Save style"
                                            AutomationProperties.Name="Save custom Whisper style"
                                            Click="AddCustomStyle_Click" />
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="WhisperCustomStyleList"
                                          Margin="0,12,0,0"
                                          ItemTemplate="{StaticResource CustomStyleRowTemplate}"
                                          AutomationProperties.Name="Custom Whisper styles" />
                        </StackPanel>

                        <StackPanel x:Name="WhisperApplicationsSection" Visibility="Collapsed">
                            <Border Style="{StaticResource QuietCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="New app rule" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Text="Use the process name only. App rules never choose a recipient or window." />
                                        </StackPanel>
                                        <TextBlock x:Name="WhisperApplicationProfileCount"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Text="0 of 64" />
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,5" Text="Process name" />
                                            <TextBox x:Name="WhisperApplicationProcessInput"
                                                     MaxLength="128"
                                                     Style="{StaticResource FieldStyle}"
                                                     AutomationProperties.Name="Application process name" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Margin="0,0,0,5" Text="Style" />
                                            <ComboBox x:Name="WhisperApplicationStylePicker"
                                                      Style="{StaticResource SoltexComboBoxStyle}"
                                                      DisplayMemberPath="DisplayName"
                                                      AutomationProperties.Name="Application Whisper style" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,5" Text="Clipboard fallback" />
                                            <ComboBox x:Name="WhisperApplicationClipboardPicker"
                                                      Style="{StaticResource SoltexComboBoxStyle}"
                                                      DisplayMemberPath="DisplayName"
                                                      AutomationProperties.Name="Application clipboard fallback permission" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Margin="0,0,0,5" Text="Context reads" />
                                            <ComboBox x:Name="WhisperApplicationContextPicker"
                                                      Style="{StaticResource SoltexComboBoxStyle}"
                                                      DisplayMemberPath="DisplayName"
                                                      AutomationProperties.Name="Application context read permission" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,5" Text="Auto-send eligibility" />
                                            <ComboBox x:Name="WhisperApplicationAutoSendPicker"
                                                      Style="{StaticResource SoltexComboBoxStyle}"
                                                      DisplayMemberPath="DisplayName"
                                                      AutomationProperties.Name="Application auto-send eligibility" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Margin="0,0,0,5" Text="Terminal submit eligibility" />
                                            <ComboBox x:Name="WhisperApplicationTerminalSubmitPicker"
                                                      Style="{StaticResource SoltexComboBoxStyle}"
                                                      DisplayMemberPath="DisplayName"
                                                      AutomationProperties.Name="Application terminal submit eligibility" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Margin="0,10,0,0"
                                               Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap"
                                               Text="Eligibility never enables global auto-send. The first-use warning and verified-submit gate still apply." />
                                    <Button x:Name="WhisperApplicationProfileAddButton"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource ActionButton}"
                                            Content="Save app rule"
                                            AutomationProperties.Name="Save Whisper application rule"
                                            Click="AddApplicationProfile_Click" />
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="WhisperApplicationProfileList"
                                          Margin="0,12,0,0"
                                          ItemTemplate="{StaticResource ApplicationProfileRowTemplate}"
                                          AutomationProperties.Name="Whisper application rules" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Scratchpad: session-only text with bounded tabs and undo. -->
                <Grid x:Name="WhisperScratchpadPanel"
                      Margin="18"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="Scratchpad" />
                            <TextBlock Margin="0,3,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="Up to five session-only notes. Closing Soltex clears them." />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="WhisperScratchpadUndoButton"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Undo"
                                    AutomationProperties.Name="Undo Scratchpad change"
                                    Click="ScratchpadUndo_Click" />
                            <Button x:Name="WhisperScratchpadRedoButton"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Redo"
                                    AutomationProperties.Name="Redo Scratchpad change"
                                    Click="ScratchpadRedo_Click" />
                            <Button x:Name="WhisperScratchpadClearButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Clear"
                                    AutomationProperties.Name="Clear active Scratchpad note"
                                    Click="ScratchpadClear_Click" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl x:Name="WhisperScratchpadTabs"
                                      ItemTemplate="{StaticResource ScratchpadTabTemplate}"
                                      AutomationProperties.Name="Scratchpad tabs">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Button x:Name="WhisperScratchpadAddTabButton"
                                Grid.Column="1"
                                MinWidth="84"
                                Style="{StaticResource ActionButton}"
                                Content="New note"
                                AutomationProperties.Name="Add Scratchpad note"
                                Click="ScratchpadAddTab_Click" />
                    </Grid>
                    <Border Grid.Row="4"
                            Background="{StaticResource FieldBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="WhisperScratchpadTextBox"
                                     MinHeight="260"
                                     Padding="14"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextBrightBrush}"
                                     CaretBrush="{StaticResource AccentBrush}"
                                     SelectionBrush="{StaticResource SelectionBrush}"
                                     FontFamily="{StaticResource MonoFont}"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     MaxLength="100000"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Active Scratchpad note"
                                     TextChanged="ScratchpadText_Changed" />
                            <TextBlock x:Name="WhisperScratchpadStatus"
                                       Grid.Row="1"
                                       Margin="12,8"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="Session memory only · 0 characters"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Privacy -->
                <Grid x:Name="WhisperPrivacyPanel" Margin="18" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="What Whisper will and will not do" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource QuietCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Off by default"
                                           Foreground="{StaticResource SignalBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           TextWrapping="Wrap"
                                           Text="Auto-send, reading text around the caret, terminal submission, and keeping transcripts on disk all start off and stay off until you turn each one on." />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource QuietCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Never"
                                           Foreground="{StaticResource DangerTextBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           TextWrapping="Wrap"
                                           Text="Whisper does not type into password fields, does not choose a recipient for you, and does not press Enter unless it can read back exactly what it inserted." />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="4"
                            Background="{StaticResource InsetBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="Evidence contains no transcript text" FontWeight="SemiBold" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Text="Diagnostics record the session state, a coarse duration band, the target category, and the policy decision. Quoted spans, paths, and URLs in provider errors are redacted before anything is written." />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
