<UserControl x:Class="Soltex.App.Views.WhisperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="{DynamicResource TextBrush}"
             FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>

        <!-- One readiness prerequisite: state dot, name, one sentence, one action. -->
        <DataTemplate x:Key="ReadinessRowTemplate">
            <Border Style="{StaticResource WhisperChecklistRowStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8"
                             Height="8"
                             Margin="2,0,10,0"
                             VerticalAlignment="Center"
                             Fill="{Binding StateBrush}" />
                    <TextBlock Grid.Column="1"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center"
                               Text="{Binding Title}"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Text="{Binding Detail}"
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Column="3"
                               VerticalAlignment="Center"
                               Text="{Binding StateLabel}"
                               Foreground="{Binding StateBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource FontMicro}"
                               FontWeight="SemiBold" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A shortcut chord rendered as the keys the user actually presses. -->
        <DataTemplate x:Key="KeycapTemplate">
            <Border Style="{StaticResource WhisperKeycapStyle}">
                <TextBlock Style="{StaticResource WhisperKeycapTextStyle}" Text="{Binding}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ShortcutRowTemplate">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{Binding Action}" />
                <ItemsControl Grid.Column="1"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Keys}"
                              ItemTemplate="{StaticResource KeycapTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Grid.Column="2"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding Description}"
                           Style="{StaticResource MutedTextStyle}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="VocabularyRowTemplate">
            <Border Margin="0,0,0,6"
                    Background="{DynamicResource InsetBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}"
                    Padding="10,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding Term}"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1"
                            Margin="12,0,0,0"
                            Padding="8,3"
                            Style="{StaticResource SecondaryButton}"
                            Content="Remove"
                            AutomationProperties.Name="{Binding RemoveAutomationName}"
                            Click="RemoveVocabulary_Click" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SnippetRowTemplate">
            <Border Margin="0,0,0,8" Style="{StaticResource QuietCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Cue}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0"
                                   MaxHeight="42"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="{Binding Preview}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButton}"
                            Content="Remove"
                            AutomationProperties.Name="{Binding RemoveAutomationName}"
                            Click="RemoveSnippet_Click" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CustomStyleRowTemplate">
            <Border Margin="0,0,0,8" Style="{StaticResource QuietCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="{Binding Summary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButton}"
                            Content="Remove"
                            AutomationProperties.Name="{Binding RemoveAutomationName}"
                            Click="RemoveCustomStyle_Click" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ApplicationProfileRowTemplate">
            <Border Margin="0,0,0,8" Style="{StaticResource QuietCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="{Binding Summary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButton}"
                            Content="Remove"
                            AutomationProperties.Name="{Binding RemoveAutomationName}"
                            Click="RemoveApplicationProfile_Click" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="HistoryRowTemplate">
            <Border Margin="0,0,0,8" Style="{StaticResource QuietCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" />
                            <TextBlock Margin="8,0,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="{Binding Meta}" />
                        </StackPanel>
                        <TextBlock Margin="0,5,0,0"
                                   MaxHeight="42"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="{Binding Preview}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButton}"
                            Content="Delete"
                            AutomationProperties.Name="{Binding DeleteAutomationName}"
                            Click="DeleteHistoryEntry_Click" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ScratchpadTabTemplate">
            <Border Margin="0,0,8,0"
                    Background="{DynamicResource InsetBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSm}">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource TabButtonStyle}"
                            Content="{Binding Title}"
                            Tag="{Binding SelectionTag}"
                            AutomationProperties.Name="{Binding OpenAutomationName}"
                            Click="ActivateScratchpadTab_Click" />
                    <Button MinWidth="30"
                            Padding="7,4"
                            Style="{StaticResource SecondaryButton}"
                            Content="×"
                            AutomationProperties.Name="{Binding CloseAutomationName}"
                            Click="CloseScratchpadTab_Click" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Command header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Whisper" />
                <TextBlock Margin="0,3,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Hold a shortcut, speak, and Whisper inserts cleaned text into the focused field." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="WhisperScaffoldPill"
                        Margin="0,0,10,0"
                        Style="{StaticResource StatusPillStyle}"
                        ToolTip="Local transcription and verified delivery are wired. Readiness remains blocked until the model, microphone, shortcuts, and target prerequisites are proven on this PC.">
                    <TextBlock Text="Setup"
                               Foreground="{DynamicResource WarningBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource FontMicro}"
                               FontWeight="SemiBold" />
                </Border>
                <Button x:Name="WhisperPreviewOverlayButton"
                        Style="{StaticResource SecondaryButton}"
                        Content="Preview overlay"
                        AutomationProperties.Name="Preview the Whisper overlay"
                        Click="PreviewOverlay_Click" />
            </StackPanel>
        </Grid>

        <!-- Readiness summary -->
        <Border x:Name="WhisperReadinessHero" Grid.Row="2" Style="{StaticResource HeroCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="WhisperReadinessDot"
                         Width="10"
                         Height="10"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource WarningBrush}" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="WhisperReadinessTitle"
                               Text="Whisper is not ready"
                               FontSize="{StaticResource FontSection}"
                               FontWeight="SemiBold"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="WhisperReadinessDetail"
                               Margin="0,3,0,0"
                               Text="Checking prerequisites."
                               Style="{StaticResource MutedTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock x:Name="WhisperReadinessAction"
                           Grid.Column="3"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Text=""
                           Foreground="{DynamicResource WarningBrush}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="{StaticResource FontMicro}" />
            </Grid>
        </Border>

        <!-- Local switcher -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <WrapPanel>
                <Button x:Name="WhisperSetupTab"
                        Tag="Selected"
                        Style="{StaticResource TabButtonStyle}"
                        Content="Setup"
                        AutomationProperties.Name="Show Whisper setup"
                        Click="WhisperSetupTab_Click" />
                <Button x:Name="WhisperShortcutsTab"
                        Margin="8,0,0,0"
                        Style="{StaticResource TabButtonStyle}"
                        Content="Shortcuts"
                        AutomationProperties.Name="Show Whisper shortcuts"
                        Click="WhisperShortcutsTab_Click" />
                <Button x:Name="WhisperChecksTab"
                        Margin="8,0,0,0"
                        Style="{StaticResource TabButtonStyle}"
                        Content="Checks"
                        AutomationProperties.Name="Show Whisper checks"
                        Click="WhisperChecksTab_Click" />
                <Button x:Name="WhisperPersonalizeTab"
                        Margin="8,0,0,0"
                        Style="{StaticResource TabButtonStyle}"
                        Content="Personalize"
                        AutomationProperties.Name="Show Whisper personalization"
                        Click="WhisperPersonalizeTab_Click" />
                <Button x:Name="WhisperLibraryTab"
                        Margin="8,0,0,0"
                        Style="{StaticResource TabButtonStyle}"
                        Content="Library"
                        AutomationProperties.Name="Show Whisper snippets styles and application rules"
                        Click="WhisperLibraryTab_Click" />
                <Button x:Name="WhisperScratchpadTab"
                        Margin="8,0,0,0"
                        Style="{StaticResource TabButtonStyle}"
                        Content="Scratchpad"
                        AutomationProperties.Name="Show Whisper Scratchpad"
                        Click="WhisperScratchpadTab_Click" />
                <Button x:Name="WhisperHistoryTab"
                        Margin="8,0,0,0"
                        Style="{StaticResource TabButtonStyle}"
                        Content="History"
                        AutomationProperties.Name="Show Whisper history"
                        Click="WhisperHistoryTab_Click" />
                <Button x:Name="WhisperPrivacyTab"
                        Margin="8,0,0,0"
                        Style="{StaticResource TabButtonStyle}"
                        Content="Privacy"
                        AutomationProperties.Name="Show Whisper privacy boundaries"
                        Click="WhisperPrivacyTab_Click" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="6" Style="{StaticResource WorkbenchStyle}">
            <Grid>

                <!-- Setup: the readiness checklist owns this surface. -->
                <Grid x:Name="WhisperSetupPanel" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Before you can dictate" />
                            <TextBlock Margin="0,3,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="Each row is one prerequisite and the single action that resolves it." />
                        </StackPanel>
                        <TextBlock x:Name="WhisperReadinessCount"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="0 ready"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource QuietCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Whisper runtime" FontWeight="SemiBold" />
                                <TextBlock x:Name="WhisperFeatureStatus"
                                           Margin="0,3,12,0"
                                           Text="Whisper is off. No global shortcuts are registered."
                                           Style="{StaticResource MutedTextStyle}"
                                           AutomationProperties.LiveSetting="Polite"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="WhisperFeatureToggleButton"
                                    Grid.Column="1"
                                    MinWidth="92"
                                    Style="{StaticResource ActionButton}"
                                    Content="Turn on"
                                    AutomationProperties.Name="Turn Whisper on"
                                    Click="FeatureToggle_Click" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="4" Style="{StaticResource QuietCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Microphone" FontWeight="SemiBold" />
                                <TextBlock x:Name="WhisperCaptureStatus"
                                           Margin="0,3,0,0"
                                           Text="Checking Windows input devices."
                                           Style="{StaticResource MutedTextStyle}"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <Button x:Name="WhisperRefreshDevicesButton"
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Refresh"
                                    AutomationProperties.Name="Refresh Whisper microphone devices"
                                    Click="RefreshDevices_Click" />
                            <Button x:Name="WhisperMicrophoneTestButton"
                                    Grid.Column="3"
                                    Style="{StaticResource ActionButton}"
                                    Content="Test microphone"
                                    IsEnabled="False"
                                    AutomationProperties.Name="Start a five second microphone test"
                                    Click="MicrophoneTest_Click" />
                            <ComboBox x:Name="WhisperInputDevicePicker"
                                      Grid.Row="2"
                                      Grid.ColumnSpan="4"
                                      MinWidth="320"
                                      HorizontalAlignment="Stretch"
                                      Style="{StaticResource SoltexComboBoxStyle}"
                                      DisplayMemberPath="DisplayName"
                                      AutomationProperties.Name="Whisper input device"
                                      SelectionChanged="InputDevicePicker_SelectionChanged" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="6" Style="{StaticResource QuietCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="7" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Local transcription" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,12,0"
                                               Text="Whisper.net CPU · multilingual Turbo Q5 · about 547 MiB"
                                               Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource StatusPillStyle}">
                                    <TextBlock x:Name="WhisperModelStatePill"
                                               Text="NOT INSTALLED"
                                               Foreground="{DynamicResource WarningBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="{StaticResource FontMicro}"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <TextBlock x:Name="WhisperModelStatus"
                                       Grid.Row="2"
                                       Text="Checking the local model. No download starts automatically."
                                       Style="{StaticResource MutedTextStyle}"
                                       AutomationProperties.LiveSetting="Polite"
                                       TextWrapping="Wrap" />
                            <ProgressBar x:Name="WhisperModelProgress"
                                         Grid.Row="3"
                                         Height="4"
                                         Maximum="100"
                                         Style="{StaticResource MetricProgressStyle}"
                                         Visibility="Collapsed"
                                         AutomationProperties.Name="Local Whisper model download progress" />
                            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="WhisperProviderSelectButton"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Use local"
                                        AutomationProperties.Name="Select local Whisper"
                                        Click="ProviderSelect_Click" />
                                <Button x:Name="WhisperModelDeleteButton"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Delete"
                                        Visibility="Collapsed"
                                        AutomationProperties.Name="Delete the installed local Whisper model"
                                        Click="ModelDelete_Click" />
                                <Button x:Name="WhisperModelActionButton"
                                        Style="{StaticResource ActionButton}"
                                        Content="Install"
                                        AutomationProperties.Name="Install the local Whisper model"
                                        Click="ModelAction_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ItemsControl x:Name="WhisperReadinessList"
                                  Grid.Row="8"
                                  ItemTemplate="{StaticResource ReadinessRowTemplate}"
                                  AutomationProperties.Name="Whisper readiness checks"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Grid>

                <!-- Owner-controlled checks remain isolated from the everyday setup flow. -->
                <Grid x:Name="WhisperChecksPanel" Margin="18" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="Finish on this PC" />
                            <TextBlock Margin="0,3,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="One observed check at a time. Results live only for this Soltex session." />
                        </StackPanel>
                        <TextBlock x:Name="WhisperOwnerChecksCount"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="0 of 6 passed"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource QuietCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="WhisperOwnerCheckTitle"
                                           Text="Next: Physical shortcut"
                                           FontWeight="SemiBold"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="WhisperOwnerCheckDetail"
                                           Margin="0,3,16,0"
                                           Text="Finish Setup, then start the first owner check."
                                           Style="{StaticResource MutedTextStyle}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <Button x:Name="WhisperOwnerCheckResetButton"
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Reset"
                                    IsEnabled="False"
                                    AutomationProperties.Name="Reset session-only Whisper owner checks"
                                    Click="OwnerCheckReset_Click" />
                            <Button x:Name="WhisperOwnerCheckActionButton"
                                    Grid.Column="3"
                                    MinWidth="126"
                                    Style="{StaticResource ActionButton}"
                                    Content="Start next check"
                                    IsEnabled="False"
                                    AutomationProperties.Name="Start the next Whisper owner check"
                                    Click="OwnerCheckAction_Click" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="3"
                               VerticalAlignment="Center"
                               Text="Content-free: no keys, audio, transcript, target text, process name, or path is retained."
                               Style="{StaticResource MutedTextStyle}" />
                    <ItemsControl x:Name="WhisperOwnerCheckList"
                                  Grid.Row="4"
                                  ItemTemplate="{StaticResource ReadinessRowTemplate}"
                                  AutomationProperties.Name="Owner-controlled Whisper checks"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Grid>

                <!-- Shortcuts -->
                <Grid x:Name="WhisperShortcutsPanel" Margin="18" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Default shortcuts" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="Up to four chords per action and three keys per chord, including Mouse 4 and Mouse 5." />
                    </StackPanel>
                    <ItemsControl x:Name="WhisperShortcutList"
                                  Grid.Row="2"
                                  ItemTemplate="{StaticResource ShortcutRowTemplate}"
                                  AutomationProperties.Name="Whisper default shortcuts"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    <Border Grid.Row="3"
                            Background="{DynamicResource InsetBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="10">
                        <TextBlock x:Name="WhisperShortcutStatus"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="Whisper is off, so no global shortcut is registered." />
                    </Border>
                </Grid>

                <!-- Personalization: provider hints and deterministic style settings. -->
                <ScrollViewer x:Name="WhisperPersonalizePanel"
                              Margin="18"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   Text="Personalization" />
                        <TextBlock Margin="0,3,0,12"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   Text="Vocabulary guides recognition; formatting is applied after transcription." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource QuietCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Language" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,8"
                                               Style="{StaticResource MutedTextStyle}"
                                               Text="Auto-detect supports mixed-language speech." />
                                    <ComboBox x:Name="WhisperLanguagePicker"
                                              Style="{StaticResource SoltexComboBoxStyle}"
                                              DisplayMemberPath="DisplayName"
                                              AutomationProperties.Name="Whisper language"
                                              SelectionChanged="PersonalizationPicker_SelectionChanged" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource QuietCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Default style" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,8"
                                               Style="{StaticResource MutedTextStyle}"
                                               Text="A terminal target still forces the literal terminal style." />
                                    <ComboBox x:Name="WhisperStylePicker"
                                              Style="{StaticResource SoltexComboBoxStyle}"
                                              DisplayMemberPath="DisplayName"
                                              AutomationProperties.Name="Whisper default style"
                                              SelectionChanged="PersonalizationPicker_SelectionChanged" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Margin="0,12,0,0" Style="{StaticResource QuietCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Personal vocabulary" FontWeight="SemiBold" />
                                    <TextBlock x:Name="WhisperVocabularyCount"
                                               Margin="0,3,0,0"
                                               Style="{StaticResource MutedTextStyle}"
                                               Text="0 of 512 terms" />
                                </StackPanel>
                                <TextBlock x:Name="WhisperPersonalizationStatus"
                                           Grid.Column="1"
                                           MaxWidth="420"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="Saved locally for this Windows account."
                                           TextTrimming="CharacterEllipsis"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBox x:Name="WhisperVocabularyInput"
                                         Grid.Row="2"
                                         MaxLength="64"
                                         Style="{StaticResource FieldStyle}"
                                         AutomationProperties.Name="New Whisper vocabulary term" />
                                <Button x:Name="WhisperVocabularyAddButton"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        MinWidth="76"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource ActionButton}"
                                        Content="Add term"
                                        AutomationProperties.Name="Add vocabulary term"
                                        Click="AddVocabulary_Click" />
                                <ListBox x:Name="WhisperVocabularyList"
                                         Grid.Row="4"
                                         Grid.ColumnSpan="2"
                                         MaxHeight="220"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemTemplate="{StaticResource VocabularyRowTemplate}"
                                         AutomationProperties.Name="Personal vocabulary"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Library: one editor at a time keeps dense rules understandable. -->
                <ScrollViewer x:Name="WhisperLibraryPanel"
                              Margin="18"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="Personal library" />
                                <TextBlock Margin="0,3,0,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="Reusable text and app-specific rules, stored only for this Windows account." />
                            </StackPanel>
                            <TextBlock x:Name="WhisperLibraryStatus"
                                       Grid.Column="1"
                                       MaxWidth="420"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="Saved locally for this Windows account."
                                       TextTrimming="CharacterEllipsis"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Grid>

                        <WrapPanel Margin="0,14,0,14">
                            <Button x:Name="WhisperSnippetsSectionTab"
                                    Tag="Selected"
                                    Style="{StaticResource TabButtonStyle}"
                                    Content="Snippets"
                                    AutomationProperties.Name="Edit Whisper snippets"
                                    Click="WhisperSnippetsSectionTab_Click" />
                            <Button x:Name="WhisperStylesSectionTab"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource TabButtonStyle}"
                                    Content="Styles"
                                    AutomationProperties.Name="Edit Whisper custom styles"
                                    Click="WhisperStylesSectionTab_Click" />
                            <Button x:Name="WhisperApplicationsSectionTab"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource TabButtonStyle}"
                                    Content="App rules"
                                    AutomationProperties.Name="Edit Whisper application rules"
                                    Click="WhisperApplicationsSectionTab_Click" />
                        </WrapPanel>

                        <StackPanel x:Name="WhisperSnippetsSection">
                            <Border Style="{StaticResource QuietCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="New snippet" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Text="Say the exact cue to insert the saved text." />
                                        </StackPanel>
                                        <TextBlock x:Name="WhisperSnippetCount"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Text="0 of 64" />
                                    </Grid>
                                    <TextBlock Margin="0,12,0,5" Text="Spoken cue" />
                                    <TextBox x:Name="WhisperSnippetCueInput"
                                             MaxLength="80"
                                             Style="{StaticResource FieldStyle}"
                                             AutomationProperties.Name="New snippet spoken cue" />
                                    <TextBlock Margin="0,10,0,5" Text="Text to insert" />
                                    <TextBox x:Name="WhisperSnippetContentInput"
                                             MinHeight="96"
                                             MaxHeight="180"
                                             MaxLength="4000"
                                             Style="{StaticResource FieldStyle}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="New snippet content" />
                                    <Button x:Name="WhisperSnippetAddButton"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource ActionButton}"
                                            Content="Save snippet"
                                            AutomationProperties.Name="Save new Whisper snippet"
                                            Click="AddSnippet_Click" />
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="WhisperSnippetList"
                                          Margin="0,12,0,0"
                                          ItemTemplate="{StaticResource SnippetRowTemplate}"
                                          AutomationProperties.Name="Saved Whisper snippets" />
                        </StackPanel>

                        <StackPanel x:Name="WhisperStylesSection" Visibility="Collapsed">
                            <Border Style="{StaticResource QuietCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="New style" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Style="{StaticResource MutedTextStyle}"
                                                Text="Choose a predictable formatting style." />
                                        </StackPanel>
                                        <TextBlock x:Name="WhisperCustomStyleCount"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Text="0 of 16" />
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,5" Text="Style name" />
                                            <TextBox x:Name="WhisperCustomStyleNameInput"
                                                     MaxLength="64"
                                                     Style="{StaticResource FieldStyle}"
                                                     AutomationProperties.Name="New custom style name" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Margin="0,0,0,5" Text="Formatting rules" />
                                            <ComboBox x:Name="WhisperCustomStyleBasePicker"
                                                      Style="{StaticResource SoltexComboBoxStyle}"
                                                      DisplayMemberPath="DisplayName"
                                                      AutomationProperties.Name="Custom style formatting rules" />
                                        </StackPanel>
                                    </Grid>
                                    <Button x:Name="WhisperCustomStyleAddButton"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource ActionButton}"
                                            Content="Save style"
                                            AutomationProperties.Name="Save custom Whisper style"
                                            Click="AddCustomStyle_Click" />
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="WhisperCustomStyleList"
                                          Margin="0,12,0,0"
                                          ItemTemplate="{StaticResource CustomStyleRowTemplate}"
                                          AutomationProperties.Name="Custom Whisper styles" />
                        </StackPanel>

                        <StackPanel x:Name="WhisperApplicationsSection" Visibility="Collapsed">
                            <Border Style="{StaticResource QuietCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="New app rule" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       Text="Use the process name only. App rules never choose a recipient or window." />
                                        </StackPanel>
                                        <TextBlock x:Name="WhisperApplicationProfileCount"
                                                   Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Text="0 of 64" />
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,5" Text="Process name" />
                                            <TextBox x:Name="WhisperApplicationProcessInput"
                                                     MaxLength="128"
                                                     Style="{StaticResource FieldStyle}"
                                                     AutomationProperties.Name="Application process name" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Margin="0,0,0,5" Text="Style" />
                                            <ComboBox x:Name="WhisperApplicationStylePicker"
                                                      Style="{StaticResource SoltexComboBoxStyle}"
                                                      DisplayMemberPath="DisplayName"
                                                      AutomationProperties.Name="Application Whisper style" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,5" Text="Clipboard fallback" />
                                            <ComboBox x:Name="WhisperApplicationClipboardPicker"
                                                      Style="{StaticResource SoltexComboBoxStyle}"
                                                      DisplayMemberPath="DisplayName"
                                                      AutomationProperties.Name="Application clipboard fallback permission" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Margin="0,0,0,5" Text="Context reads" />
                                            <ComboBox x:Name="WhisperApplicationContextPicker"
                                                      Style="{StaticResource SoltexComboBoxStyle}"
                                                      DisplayMemberPath="DisplayName"
                                                      AutomationProperties.Name="Application context read permission" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Margin="0,0,0,5" Text="Auto-send eligibility" />
                                            <ComboBox x:Name="WhisperApplicationAutoSendPicker"
                                                      Style="{StaticResource SoltexComboBoxStyle}"
                                                      DisplayMemberPath="DisplayName"
                                                      AutomationProperties.Name="Application auto-send eligibility" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Margin="0,0,0,5" Text="Terminal submit eligibility" />
                                            <ComboBox x:Name="WhisperApplicationTerminalSubmitPicker"
                                                      Style="{StaticResource SoltexComboBoxStyle}"
                                                      DisplayMemberPath="DisplayName"
                                                      AutomationProperties.Name="Application terminal submit eligibility" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Margin="0,10,0,0"
                                               Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap"
                                               Text="Eligibility never enables global auto-send. The first-use warning and verified-submit gate still apply." />
                                    <Button x:Name="WhisperApplicationProfileAddButton"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource ActionButton}"
                                            Content="Save app rule"
                                            AutomationProperties.Name="Save Whisper application rule"
                                            Click="AddApplicationProfile_Click" />
                                </StackPanel>
                            </Border>
                            <ItemsControl x:Name="WhisperApplicationProfileList"
                                          Margin="0,12,0,0"
                                          ItemTemplate="{StaticResource ApplicationProfileRowTemplate}"
                                          AutomationProperties.Name="Whisper application rules" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Scratchpad: session-only text with bounded tabs and undo. -->
                <Grid x:Name="WhisperScratchpadPanel"
                      Margin="18"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="Scratchpad" />
                            <TextBlock Margin="0,3,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="Up to five session-only notes. Closing Soltex clears them." />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="WhisperScratchpadUndoButton"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Undo"
                                    AutomationProperties.Name="Undo Scratchpad change"
                                    Click="ScratchpadUndo_Click" />
                            <Button x:Name="WhisperScratchpadRedoButton"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Redo"
                                    AutomationProperties.Name="Redo Scratchpad change"
                                    Click="ScratchpadRedo_Click" />
                            <Button x:Name="WhisperScratchpadClearButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Clear"
                                    AutomationProperties.Name="Clear active Scratchpad note"
                                    Click="ScratchpadClear_Click" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl x:Name="WhisperScratchpadTabs"
                                      ItemTemplate="{StaticResource ScratchpadTabTemplate}"
                                      AutomationProperties.Name="Scratchpad tabs">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Button x:Name="WhisperScratchpadAddTabButton"
                                Grid.Column="1"
                                MinWidth="84"
                                Style="{StaticResource ActionButton}"
                                Content="New note"
                                AutomationProperties.Name="Add Scratchpad note"
                                Click="ScratchpadAddTab_Click" />
                    </Grid>
                    <Border Grid.Row="4"
                            Background="{DynamicResource FieldBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="WhisperScratchpadTextBox"
                                     MinHeight="260"
                                     Padding="14"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextBrightBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     SelectionBrush="{DynamicResource SelectionBrush}"
                                     FontFamily="{StaticResource MonoFont}"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     MaxLength="100000"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Active Scratchpad note"
                                     TextChanged="ScratchpadText_Changed" />
                            <TextBlock x:Name="WhisperScratchpadStatus"
                                       Grid.Row="1"
                                       Margin="12,8"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="Session memory only · 0 characters"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- History: bounded session memory, never the global Activity feed. -->
                <Grid x:Name="WhisperHistoryPanel"
                      Margin="18"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="Transcript history" />
                            <TextBlock x:Name="WhisperHistoryStatus"
                                       Margin="0,3,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="Session memory only. Closing Soltex clears it."
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="WhisperHistoryCount"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="0 entries" />
                            <Button x:Name="WhisperHistoryClearButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Clear history"
                                    AutomationProperties.Name="Clear all Whisper history"
                                    Click="ClearHistory_Click" />
                        </StackPanel>
                    </Grid>
                    <Border x:Name="WhisperHistoryEmptyState"
                            Grid.Row="2"
                            Style="{StaticResource QuietCardStyle}">
                        <StackPanel>
                            <TextBlock Text="No completed transcripts this session"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="History appears after a successful dictation." />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="4"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="WhisperHistoryList"
                                      ItemTemplate="{StaticResource HistoryRowTemplate}"
                                      AutomationProperties.Name="Whisper transcript history" />
                    </ScrollViewer>
                </Grid>

                <!-- Privacy: explicit settings with safe defaults and inline consent. -->
                <ScrollViewer x:Name="WhisperPrivacyPanel"
                              Margin="18"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}"
                                           Text="Privacy and delivery" />
                                <TextBlock Margin="0,3,0,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="Every outward capability starts off or fails closed." />
                            </StackPanel>
                            <TextBlock x:Name="WhisperPrivacyStatus"
                                       Grid.Column="1"
                                       MaxWidth="420"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="Safe defaults are active."
                                       TextTrimming="CharacterEllipsis"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource QuietCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Auto-send" FontWeight="SemiBold" />
                                        <TextBlock x:Name="WhisperAutoSendDetail"
                                                   Margin="0,4,12,0"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Text="Off · Enter cannot be emitted."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button x:Name="WhisperAutoSendButton"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="Review"
                                            AutomationProperties.Name="Review Whisper auto-send"
                                            Click="AutoSend_Click" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource QuietCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Context reads" FontWeight="SemiBold" />
                                        <TextBlock x:Name="WhisperContextReadsDetail"
                                                   Margin="0,4,12,0"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Text="Off · text around the caret is not read."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button x:Name="WhisperContextReadsButton"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="Turn on"
                                            AutomationProperties.Name="Turn Whisper context reads on"
                                            Click="ContextReads_Click" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Border x:Name="WhisperAutoSendWarningPanel"
                                Margin="0,12,0,0"
                                Background="{DynamicResource InsetBrush}"
                                BorderBrush="{DynamicResource WarningBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSm}"
                                Padding="12"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Auto-send can send text immediately"
                                               Foreground="{DynamicResource WarningBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,5,16,0"
                                               Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap"
                                               Text="Whisper will still require an approved app rule, the same focused target, exact read-back verification, and an authorized submit request. Unknown, protected, elevated, stale, and unverifiable targets remain blocked." />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button x:Name="WhisperAutoSendKeepOffButton"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="Keep off"
                                            AutomationProperties.Name="Keep Whisper auto-send off"
                                            Click="CancelAutoSendWarning_Click" />
                                    <Button x:Name="WhisperAutoSendConfirmButton"
                                            Style="{StaticResource ActionButton}"
                                            Content="I understand, turn on"
                                            AutomationProperties.Name="Accept the Whisper auto-send warning and turn it on"
                                            Click="ConfirmAutoSendWarning_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource QuietCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Session history" FontWeight="SemiBold" />
                                    <TextBlock x:Name="WhisperHistoryStorageDetail"
                                               Margin="0,4,0,8"
                                               Style="{StaticResource MutedTextStyle}"
                                               Text="Session memory is cleared when Soltex closes." />
                                    <ComboBox x:Name="WhisperHistoryModePicker"
                                              Style="{StaticResource SoltexComboBoxStyle}"
                                              DisplayMemberPath="DisplayName"
                                              AutomationProperties.Name="Whisper history mode"
                                              SelectionChanged="PrivacyPicker_SelectionChanged" />
                                    <StackPanel x:Name="WhisperHistoryRetentionPanel"
                                                Margin="0,10,0,0"
                                                Visibility="Collapsed">
                                        <TextBlock Margin="0,0,0,6"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   Text="Delete retained entries after" />
                                        <ComboBox x:Name="WhisperHistoryRetentionPicker"
                                                  Style="{StaticResource SoltexComboBoxStyle}"
                                                  DisplayMemberPath="DisplayName"
                                                  AutomationProperties.Name="Whisper encrypted history retention period"
                                                  SelectionChanged="PrivacyPicker_SelectionChanged" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource QuietCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Clipboard fallback" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,4,0,8"
                                               Style="{StaticResource MutedTextStyle}"
                                               Text="Restore only while Whisper still owns the clipboard." />
                                    <ComboBox x:Name="WhisperClipboardBehaviorPicker"
                                              Style="{StaticResource SoltexComboBoxStyle}"
                                              DisplayMemberPath="DisplayName"
                                              AutomationProperties.Name="Whisper clipboard fallback behavior"
                                              SelectionChanged="PrivacyPicker_SelectionChanged" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,12,0,0" Style="{StaticResource QuietCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Overlay transcript preview" FontWeight="SemiBold" />
                                    <TextBlock x:Name="WhisperTranscriptPreviewDetail"
                                               Margin="0,4,12,0"
                                               Style="{StaticResource MutedTextStyle}"
                                               Text="Off · the floating surface does not echo dictated text."
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="WhisperTranscriptPreviewButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Turn on"
                                        AutomationProperties.Name="Turn Whisper transcript preview on"
                                        Click="TranscriptPreview_Click" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource QuietCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Never" Foreground="{DynamicResource DangerTextBrush}" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap"
                                               Text="Whisper does not type into password fields, choose a recipient, or press Enter without exact read-back verification." />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource QuietCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Private diagnostics" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,0"
                                               Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap"
                                               Text="Diagnostics record status and outcomes, never dictated words or audio." />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
