<UserControl x:Class="Soltex.App.Views.CaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="{DynamicResource TextBrush}"
             Focusable="False"
             AutomationProperties.Name="Capture workspace">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="1" />
            <RowDefinition Height="22" />
            <RowDefinition Height="*" />
            <RowDefinition Height="0" />
            <RowDefinition Height="0" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Capture" />
            </StackPanel>
            <Border x:Name="CaptureHeaderState"
                    Grid.Column="1"
                    Style="{StaticResource StatusPillStyle}"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <TextBlock x:Name="CaptureStatusPillText"
                           Text="CHECKING"
                           Foreground="{DynamicResource MutedBrush}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="{StaticResource FontMicro}" />
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource BorderBrush}" />

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Screenshot" />
                </StackPanel>

                <Border Grid.Row="2"
                        MinHeight="360"
                        Background="{DynamicResource QuietBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLg}"
                        Padding="32">
                    <StackPanel MaxWidth="430"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="&#xE7F4;"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="38"
                                   AutomationProperties.Name="Display or window" />
                        <TextBlock x:Name="CaptureActionTitle"
                                   Margin="0,18,0,0"
                                   Text="Choose a window or display"
                                   Foreground="{DynamicResource TextBrush}"
                                   HorizontalAlignment="Center"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="{StaticResource FontDisplaySm}"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="CaptureActionDetail"
                                   Margin="0,7,0,0"
                                   Text="Checking Windows capture support…"
                                   TextAlignment="Center"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="TakeScreenshotButton"
                                Margin="0,24,0,0"
                                MinWidth="154"
                                HorizontalAlignment="Center"
                                Style="{StaticResource ActionButton}"
                                Content="Take screenshot"
                                IsEnabled="False"
                                AutomationProperties.Name="Take screenshot"
                                Click="TakeScreenshotButton_Click" />
                    </StackPanel>
                </Border>

                <Border x:Name="LastCapturePanel"
                        Grid.Row="4"
                        Background="{DynamicResource QuietBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,0,0,0"
                        Padding="14,12"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="LastCaptureTitle"
                                       Text="Screenshot saved"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="LastCaptureDetail"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="PNG · stored locally" />
                        </StackPanel>
                        <Button x:Name="OpenCaptureFolderButton"
                                Grid.Column="1"
                                Margin="20,0,0,0"
                                Style="{StaticResource SecondaryButton}"
                                Content="Open folder"
                                AutomationProperties.Name="Open screenshot folder"
                                Click="OpenCaptureFolderButton_Click" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1"
                    Background="{DynamicResource BorderBrush}" />

            <StackPanel Grid.Column="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Recording" />
                </Grid>
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Not available in this build."
                           TextWrapping="Wrap" />

                <Border Margin="0,24,0,0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,18,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Storage" />
                        <CheckBox x:Name="IncludePointerCheckBox"
                                  Margin="0,12,0,0"
                                  Content="Include pointer"
                                  Foreground="{DynamicResource TextBrush}"
                                  IsChecked="True"
                                  AutomationProperties.Name="Include pointer in screenshot" />
                        <TextBlock x:Name="CaptureStorageText"
                                   Margin="0,9,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="Saved to Pictures\Soltex. Soltex does not upload it or add file details to Activity."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="CaptureFooterText"
                   Grid.Row="6"
                   Visibility="Collapsed"
                   Text="Waiting for Windows"
                   Foreground="{DynamicResource QuietTextBrush}"
                   FontFamily="{StaticResource MonoFont}"
                   FontSize="{StaticResource FontMicro}"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</UserControl>
