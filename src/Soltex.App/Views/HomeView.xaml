<UserControl x:Class="Soltex.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Soltex.App.Controls"
             Background="Transparent"
             Foreground="{DynamicResource TextBrush}"
             FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="230" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Overview" />
                    <TextBlock Margin="0,3,0,0"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Live system state with the important signals first." />
                </StackPanel>
                <Border x:Name="HomeStatePill" Grid.Column="1" Style="{StaticResource StatusPillStyle}" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="HomeStateDot" Width="7" Height="7" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="HomeStateText"
                                   Margin="8,0,0,0"
                                   Text="WAITING"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="10"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="HomeHeroCard" Grid.Row="2" Style="{StaticResource HeroCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,28,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Processor" Foreground="{DynamicResource SignalBrush}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" />
                        <StackPanel Grid.Row="1" Margin="0,5,0,0" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock x:Name="CpuHeroValue" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="52" FontWeight="SemiBold" />
                            <TextBlock Margin="12,0,0,10" Text="CPU" Foreground="{DynamicResource MutedBrush}" FontSize="13" />
                        </StackPanel>
                        <controls:Sparkline x:Name="CpuSparkline"
                                            Grid.Row="2"
                                            Margin="0,8,0,6"
                                            MinHeight="62"
                                            Stroke="{DynamicResource AccentBrush}"
                                            Fill="{DynamicResource AccentAreaBrush}"
                                            StrokeThickness="2.4"
                                            AutomationProperties.Name="Recent CPU utilization" />
                        <TextBlock x:Name="HomeCapturedText"
                                   Grid.Row="3"
                                   Foreground="{DynamicResource QuietTextBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Text="Waiting for the first bounded sample" />
                    </Grid>

                    <Border x:Name="MachineProfileCard"
                            Grid.Column="1"
                            Background="{DynamicResource QuietBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSm}"
                            Padding="14">
                        <StackPanel>
                            <TextBlock Text="This PC" Foreground="{DynamicResource MutedBrush}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" />
                            <TextBlock x:Name="MachineNameText" Margin="0,8,0,0" Text="Local machine" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="MachineOsText" Margin="0,5,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Text="Reading Windows profile…" />
                            <Border Margin="0,16,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Device mesh" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                        <TextBlock Text="Local observation only" Margin="0,4,0,0" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="NOT ENROLLED"
                                               Foreground="{DynamicResource WarningBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="9"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="System signals" />
                        <TextBlock Margin="0,4,0,17" Style="{StaticResource MutedTextStyle}" Text="Supported Windows readings, refreshed without elevation." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="82" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Memory" Foreground="{DynamicResource MutedBrush}" />
                            <ProgressBar x:Name="MemoryProgress" Grid.Column="1" Margin="12,0" Style="{StaticResource MetricProgressStyle}" Maximum="100" VerticalAlignment="Center" AutomationProperties.Name="Physical memory in use" />
                            <TextBlock x:Name="MemoryText" Grid.Column="2" Text="Unavailable" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="82" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StorageNameText" Text="Storage" Foreground="{DynamicResource MutedBrush}" />
                            <ProgressBar x:Name="StorageProgress" Grid.Column="1" Margin="12,0" Style="{StaticResource MetricProgressStyle}" Maximum="100" VerticalAlignment="Center" Foreground="{DynamicResource SignalBrush}" AutomationProperties.Name="Primary storage in use" />
                            <TextBlock x:Name="StorageText" Grid.Column="2" Text="Unavailable" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,17,0,0" Background="{DynamicResource QuietBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="12,10">
                                <TextBlock x:Name="TopProcessNameText" Text="Waiting for process sample" FontWeight="SemiBold" />
                                <TextBlock Text="Highest observed CPU in the bounded process list" Margin="0,3,0,0" Style="{StaticResource MutedTextStyle}" FontSize="10" />
                            </StackPanel>
                            <TextBlock x:Name="TopProcessValueText"
                                       Grid.Column="1"
                                       Margin="12"
                                       Text="—"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource QuietCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Network" />
                        <TextBlock Margin="0,4,0,12" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Text="Current traffic across active Windows interfaces." />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="NetworkRateText" Text="Unavailable" FontFamily="{StaticResource DisplayFont}" FontSize="25" />
                            <TextBlock x:Name="NetworkStatusText" Grid.Column="1" Text="WAITING" Foreground="{DynamicResource WarningBrush}" FontFamily="{StaticResource MonoFont}" FontSize="9" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="NetworkDetailText" Margin="0,3,0,0" Text="Waiting for a stable interface sample" Foreground="{DynamicResource QuietTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="9" TextWrapping="Wrap" />
                        <controls:Sparkline x:Name="NetworkSparkline"
                                            Height="52"
                                            Margin="0,12,0,14"
                                            AutoScale="True"
                                            Stroke="{DynamicResource SignalBrush}"
                                            Fill="{DynamicResource SignalAreaBrush}"
                                            StrokeThickness="2"
                                            AutomationProperties.Name="Recent aggregate network throughput" />
                    </StackPanel>
                </Border>
            </Grid>
    </Grid>
</UserControl>
