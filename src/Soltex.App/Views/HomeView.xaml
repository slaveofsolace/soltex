<UserControl x:Class="Soltex.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Soltex.App.Controls"
             Background="Transparent"
             Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="01 / LOCAL WORKSPACE" />
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource PageTitleStyle}" Text="Home" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource MutedTextStyle}"
                               FontSize="14"
                               Text="A calm, factual view of this machine—what is known, what is limited, and what needs attention." />
                </StackPanel>
                <Border x:Name="HomeStatePill" Grid.Column="1" Style="{StaticResource StatusPillStyle}" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="HomeStateDot" Width="7" Height="7" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="HomeStateText"
                                   Margin="8,0,0,0"
                                   Text="WAITING"
                                   Foreground="{StaticResource WarningBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="10"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="HomeHeroCard" Margin="0,20,0,0" Style="{StaticResource HeroCardStyle}" Height="265">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,28,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="LIVE RHYTHM" Style="{StaticResource PageEyebrowStyle}" Foreground="{StaticResource SignalBrush}" />
                        <StackPanel Grid.Row="1" Margin="0,5,0,0" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock x:Name="CpuHeroValue" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="64" />
                            <TextBlock Margin="12,0,0,10" Text="CPU" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                        </StackPanel>
                        <controls:Sparkline x:Name="CpuSparkline"
                                            Grid.Row="2"
                                            Margin="0,8,0,6"
                                            MinHeight="62"
                                            Stroke="{StaticResource AccentBrush}"
                                            Fill="#183F302A"
                                            StrokeThickness="2.4" />
                        <TextBlock x:Name="HomeCapturedText"
                                   Grid.Row="3"
                                   Foreground="{StaticResource QuietTextBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Text="Waiting for the first bounded sample" />
                    </Grid>

                    <Border x:Name="MachineProfileCard"
                            Grid.Column="1"
                            Background="#20201D"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="13"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="THIS MACHINE" Style="{StaticResource PageEyebrowStyle}" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="MachineNameText" Margin="0,8,0,0" Text="Local machine" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="MachineOsText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="Reading Windows profile…" />
                            <Border Margin="0,16,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Device Fabric" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                        <TextBlock Text="Local observation only" Margin="0,4,0,0" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="NOT ENROLLED"
                                               Foreground="{StaticResource WarningBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="9"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.62*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="System signals" />
                        <TextBlock Margin="0,4,0,17" Style="{StaticResource MutedTextStyle}" Text="Supported Windows readings, refreshed without elevation." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="82" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Memory" Foreground="{StaticResource MutedBrush}" />
                            <ProgressBar x:Name="MemoryProgress" Grid.Column="1" Margin="12,0" Style="{StaticResource MetricProgressStyle}" Maximum="100" VerticalAlignment="Center" />
                            <TextBlock x:Name="MemoryText" Grid.Column="2" Text="Unavailable" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="82" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StorageNameText" Text="Storage" Foreground="{StaticResource MutedBrush}" />
                            <ProgressBar x:Name="StorageProgress" Grid.Column="1" Margin="12,0" Style="{StaticResource MetricProgressStyle}" Maximum="100" VerticalAlignment="Center" Foreground="{StaticResource SignalBrush}" />
                            <TextBlock x:Name="StorageText" Grid.Column="2" Text="Unavailable" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,17,0,0" Background="{StaticResource QuietBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="12,10">
                                <TextBlock x:Name="TopProcessNameText" Text="Waiting for process sample" FontWeight="SemiBold" />
                                <TextBlock Text="Highest observed CPU in the bounded process list" Margin="0,3,0,0" Style="{StaticResource MutedTextStyle}" FontSize="10" />
                            </StackPanel>
                            <TextBlock x:Name="TopProcessValueText"
                                       Grid.Column="1"
                                       Margin="12"
                                       Text="—"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource QuietCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Signal honesty" />
                        <TextBlock Margin="0,4,0,16" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Text="Soltex leaves unsupported signals visibly unfilled." />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="GPU telemetry" />
                            <TextBlock Grid.Column="1" Text="UNAVAILABLE" Foreground="{StaticResource WarningBrush}" FontFamily="{StaticResource MonoFont}" FontSize="9" />
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Network rate" />
                            <TextBlock Grid.Column="1" Text="NOT SAMPLED" Foreground="{StaticResource WarningBrush}" FontFamily="{StaticResource MonoFont}" FontSize="9" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Remote peers" />
                            <TextBlock Grid.Column="1" Text="NONE ENROLLED" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="9" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
