<UserControl x:Class="Soltex.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Soltex.App.Controls"
             Background="Transparent"
             Foreground="{DynamicResource TextBrush}"
             FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="26" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="24" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Overview" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Your PC, at a glance." />
            </StackPanel>
            <Border x:Name="HomeStatePill"
                    Grid.Column="1"
                    Style="{StaticResource StatusPillStyle}"
                    VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="HomeStateDot"
                             Width="7"
                             Height="7"
                             Fill="{DynamicResource WarningBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="HomeStateText"
                               Margin="8,0,0,0"
                               Text="WAITING"
                               Foreground="{DynamicResource WarningBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="HomeHeroCard"
              Grid.Row="2"
              MinHeight="244"
              MaxHeight="266">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="1*" MinWidth="230" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="PROCESSOR"
                           Foreground="{DynamicResource AccentBrush}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="{StaticResource FontMicro}"
                           FontWeight="SemiBold" />
                <StackPanel Grid.Row="1"
                            Margin="0,8,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">
                    <TextBlock x:Name="CpuHeroValue"
                               Text="—"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="68"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="14,0,0,14"
                               Text="total CPU"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="{StaticResource FontCaption}"
                               VerticalAlignment="Bottom" />
                </StackPanel>
                <controls:Sparkline x:Name="CpuSparkline"
                                    Grid.Row="2"
                                    Margin="0,12,0,10"
                                    MinHeight="82"
                                    Stroke="{DynamicResource AccentBrush}"
                                    Fill="{DynamicResource AccentAreaBrush}"
                                    GridBrush="{DynamicResource BorderBrush}"
                                    GridLineCount="3"
                                    ShowLastPoint="True"
                                    StrokeThickness="2.4"
                                    AutomationProperties.Name="Recent CPU utilization" />
                <TextBlock x:Name="HomeCapturedText"
                           Grid.Row="3"
                           Foreground="{DynamicResource QuietTextBrush}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="{StaticResource FontMicro}"
                           TextWrapping="Wrap"
                           Text="Waiting for the first update" />
            </Grid>

            <Border x:Name="MachineProfileCard"
                    Grid.Column="2"
                    MinWidth="230"
                    Padding="28,0,0,0"
                    Background="Transparent"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="THIS PC"
                                   Foreground="{DynamicResource QuietTextBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="{StaticResource FontMicro}" />
                        <TextBlock x:Name="MachineNameText"
                                   Margin="0,7,0,0"
                                   Text="Local machine"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="MachineOsText"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="{StaticResource FontCaption}"
                                   TextWrapping="Wrap"
                                   Text="Reading Windows profile…" />
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Text="SYSTEM LOAD"
                               Foreground="{DynamicResource QuietTextBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource FontMicro}" />

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="58" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Memory" Foreground="{DynamicResource MutedBrush}" />
                        <ProgressBar x:Name="MemoryProgress"
                                     Grid.Column="1"
                                     Margin="10,0"
                                     Style="{StaticResource MetricProgressStyle}"
                                     Maximum="100"
                                     VerticalAlignment="Center"
                                     AutomationProperties.Name="Physical memory in use" />
                        <TextBlock x:Name="MemoryText"
                                   Grid.Column="2"
                                   Text="—"
                                   FontFamily="{StaticResource MonoFont}"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="58" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StorageNameText" Text="Storage" Foreground="{DynamicResource MutedBrush}" />
                        <ProgressBar x:Name="StorageProgress"
                                     Grid.Column="1"
                                     Margin="10,0"
                                     Style="{StaticResource MetricProgressStyle}"
                                     Maximum="100"
                                     Foreground="{DynamicResource SignalBrush}"
                                     VerticalAlignment="Center"
                                     AutomationProperties.Name="Primary storage in use" />
                        <TextBlock x:Name="StorageText"
                                   Grid.Column="2"
                                   Text="—"
                                   FontFamily="{StaticResource MonoFont}"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Remote devices"
                                       Foreground="{DynamicResource QuietTextBrush}"
                                       FontSize="{StaticResource FontCaption}" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="This PC only"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="NOT CONNECTED"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="{StaticResource FontMicro}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Padding="0,22,0,0"
                Background="Transparent"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="1*" MinWidth="230" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Network" />
                        <TextBlock x:Name="NetworkStatusText"
                                   Grid.Column="1"
                                   Text="WAITING"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="{StaticResource FontMicro}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,9,0,0" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock x:Name="NetworkRateText"
                                   Text="Unavailable"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="30" />
                        <TextBlock x:Name="NetworkDetailText"
                                   Margin="14,0,0,6"
                                   Text="Connecting…"
                                   Foreground="{DynamicResource QuietTextBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="{StaticResource FontMicro}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <controls:Sparkline x:Name="NetworkSparkline"
                                        Grid.Row="2"
                                        Margin="0,8,0,0"
                                        MinHeight="48"
                                        AutoScale="True"
                                        Stroke="{DynamicResource SignalBrush}"
                                        Fill="{DynamicResource SignalAreaBrush}"
                                        StrokeThickness="2"
                                        AutomationProperties.Name="Recent aggregate network throughput" />
                </Grid>

                <Border Grid.Column="2"
                        Padding="28,0,0,0"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="CURRENT LOAD"
                                   Foreground="{DynamicResource QuietTextBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="{StaticResource FontMicro}" />
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TopProcessNameText"
                                           Text="Waiting for activity"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="Highest observed CPU"
                                           Style="{StaticResource MutedTextStyle}"
                                           FontSize="{StaticResource FontCaption}" />
                            </StackPanel>
                            <TextBlock x:Name="TopProcessValueText"
                                       Grid.Column="1"
                                       Margin="16,0,0,0"
                                       Text="—"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="28"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
