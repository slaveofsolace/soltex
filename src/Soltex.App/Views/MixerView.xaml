<UserControl x:Class="Soltex.App.Views.MixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFont}">
    <UserControl.Resources>
        <!--
            One template drives both endpoint lists. Colour and opacity come from
            the row so an endpoint that is absent cannot present a confident
            green level reading.
        -->
        <DataTemplate x:Key="AudioEndpointTemplate">
            <Grid Margin="0,0,0,13" Opacity="{Binding RowOpacity}" ToolTip="{Binding Tooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="94" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis"
                                   FontWeight="SemiBold" />
                        <Border Margin="8,0,0,0"
                                Style="{StaticResource StatusPillStyle}"
                                Background="{StaticResource SignalQuietBrush}"
                                BorderBrush="{StaticResource SignalBorderBrush}"
                                Visibility="{Binding DefaultVisibility}">
                            <TextBlock Text="DEFAULT"
                                       Foreground="{StaticResource SignalBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMicro}" />
                        </Border>
                        <Border Margin="8,0,0,0"
                                Style="{StaticResource StatusPillStyle}"
                                Visibility="{Binding PreferredVisibility}">
                            <TextBlock Text="PREFERRED"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMicro}" />
                        </Border>
                        <Border Margin="8,0,0,0"
                                Style="{StaticResource StatusPillStyle}"
                                Visibility="{Binding MuteVisibility}">
                            <TextBlock Text="MUTED"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMicro}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,3,0,0"
                               Text="{Binding StateText}"
                               Foreground="{Binding StateBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource FontMicro}" />
                </StackPanel>
                <ProgressBar Grid.Column="1"
                             Margin="10,0"
                             Maximum="100"
                             Value="{Binding VolumePercent, Mode=OneWay}"
                             Style="{StaticResource MetricProgressStyle}"
                             Foreground="{Binding VolumeBrush}"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="{Binding VolumeAccessibleName}" />
                <TextBlock Grid.Column="2"
                           Text="{Binding VolumeText}"
                           Foreground="{Binding VolumeTextBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="{StaticResource FontMono}" />
                <Button Grid.Column="3"
                        Margin="12,0,0,0"
                        MinWidth="78"
                        Padding="9,5"
                        Content="{Binding PreferenceActionText}"
                        IsEnabled="{Binding CanSelectAsPreference}"
                        Tag="{Binding}"
                        Style="{StaticResource SecondaryButton}"
                        AutomationProperties.Name="{Binding PreferenceAccessibleName}"
                        Click="EndpointPreference_Click" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AudioSessionTemplate">
            <Grid Margin="0,0,0,12"
                  ToolTip="{Binding Tooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="170" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="78" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,3,0,0"
                               Text="{Binding EndpointName}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource QuietTextBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource FontMicro}" />
                </StackPanel>
                <Slider Grid.Column="1"
                        Margin="12,0"
                        Minimum="0"
                        Maximum="100"
                        LargeChange="10"
                        SmallChange="2"
                        Value="{Binding VolumePercent, Mode=OneWay}"
                        IsEnabled="{Binding CanControl}"
                        Tag="{Binding}"
                        Style="{StaticResource SoltexSliderStyle}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding VolumeAccessibleName}"
                        PreviewMouseLeftButtonUp="SessionVolume_Commit"
                        PreviewKeyUp="SessionVolume_CommitKey" />
                <TextBlock Grid.Column="2"
                           Text="{Binding VolumeText}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="{StaticResource FontMono}" />
                <Button Grid.Column="3"
                        Margin="12,0,0,0"
                        MinWidth="66"
                        Padding="9,5"
                        Content="{Binding MuteActionText}"
                        IsEnabled="{Binding CanControl}"
                        Tag="{Binding}"
                        Style="{StaticResource SecondaryButton}"
                        AutomationProperties.Name="{Binding MuteAccessibleName}"
                        Click="SessionMute_Click" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

            <!-- Page header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Audio" />
                    <TextBlock Margin="0,3,0,0"
                               MaxWidth="720"
                               HorizontalAlignment="Left"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Per-app volume, mute, and device context from Windows Core Audio." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="RefreshAudioButton"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButton}"
                            Content="Refresh"
                            AutomationProperties.Name="Refresh audio observation"
                            Click="RefreshAudio_Click" />
                    <Border Style="{StaticResource StatusPillStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="MixerStateDot"
                                     Width="7"
                                     Height="7"
                                     Fill="{StaticResource WarningBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="MixerStateText"
                                       Margin="8,0,0,0"
                                       Text="WAITING"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMono}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="MixerOverviewPanel" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <!-- Active app sessions are the primary job. -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" ClipToBounds="True">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Apps using audio" />
                            <TextBlock x:Name="SessionSummaryText"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="Waiting for active playback sessions." />
                        </StackPanel>
                        <Button x:Name="MoreSessionsButton"
                                Grid.Column="1"
                                Visibility="Collapsed"
                                Style="{StaticResource SecondaryButton}"
                                Content="Show more"
                                AutomationProperties.Name="Show more audio sessions"
                                Click="MoreSessions_Click" />
                    </Grid>

                    <ItemsControl x:Name="SessionItems"
                                  Margin="0,16,0,0"
                                  ItemTemplate="{StaticResource AudioSessionTemplate}"
                                  AutomationProperties.Name="Active app audio sessions" />
                    <TextBlock x:Name="NoSessionsText"
                               Margin="0,14,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               Text="No active shared-mode playback session was observed." />
                    <ItemsControl x:Name="MoreSessionItems"
                                  Margin="0,4,0,0"
                                  Visibility="Collapsed"
                                  ItemTemplate="{StaticResource AudioSessionTemplate}"
                                  AutomationProperties.Name="Additional active app audio sessions" />

                    <Border Margin="0,4,0,0"
                            Padding="0,10,0,0"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SessionActionStateText"
                                       Text="READY"
                                       Foreground="{StaticResource SignalBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMicro}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="SessionActionDetailText"
                                       Grid.Column="1"
                                       Margin="12,0,0,0"
                                       Text="Changes are confirmed by an immediate Windows read-back."
                                       Foreground="{StaticResource QuietTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Endpoint summary -->
            <Border Grid.Row="2" Style="{StaticResource HeroCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Active now" Foreground="{StaticResource SignalBrush}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Bottom">
                            <TextBlock x:Name="ActiveCountText"
                                       Text="—"
                                       Style="{StaticResource MetricValueStyle}"
                                       FontSize="42" />
                            <TextBlock x:Name="TotalCountText"
                                       Margin="10,0,0,8"
                                       Text="of 0 endpoints"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Default playback"
                                   Foreground="{StaticResource QuietTextBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="{StaticResource FontMicro}" />
                        <TextBlock x:Name="DefaultPlaybackText"
                                   Margin="0,5,0,0"
                                   MaxWidth="260"
                                   Text="Not reported"
                                   TextTrimming="CharacterEllipsis"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Default recording"
                                   Margin="0,12,0,0"
                                   Foreground="{StaticResource QuietTextBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="{StaticResource FontMicro}" />
                        <TextBlock x:Name="DefaultRecordingText"
                                   Margin="0,5,0,0"
                                   MaxWidth="260"
                                   Text="Not reported"
                                   TextTrimming="CharacterEllipsis"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="Device state"
                                   Foreground="{StaticResource QuietTextBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="{StaticResource FontMicro}"
                                   HorizontalAlignment="Right" />
                        <TextBlock x:Name="StateBreakdownText"
                                   Margin="0,6,0,0"
                                   Text="awaiting observation"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="{StaticResource FontMono}"
                                   HorizontalAlignment="Right"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap" />
                        <Button x:Name="DeviceDetailsButton"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryButton}"
                                Content="Manage devices"
                                AutomationProperties.Name="Show audio device details"
                                Click="DeviceDetails_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            </Grid>

            <!-- Playback and recording endpoints use an internal work-area scroll. -->
            <ScrollViewer x:Name="EndpointDetailsPanel"
                          Grid.Row="2"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Audio devices" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="OpenSoundSettingsButton"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButton}"
                            Content="Windows Sound"
                            AutomationProperties.Name="Open Windows Sound settings"
                            Click="OpenSoundSettings_Click" />
                    <Button x:Name="ClearEndpointPreferencesButton"
                            Margin="0,0,10,0"
                            IsEnabled="False"
                            Style="{StaticResource SecondaryButton}"
                            Content="Clear reminders"
                            AutomationProperties.Name="Clear saved audio fallback reminders"
                            Click="ClearEndpointPreferences_Click" />
                    <Button x:Name="MoreEndpointsButton"
                            Visibility="Collapsed"
                            Style="{StaticResource SecondaryButton}"
                            Content="Show more"
                            AutomationProperties.Name="Show more audio endpoints"
                            Click="MoreEndpoints_Click" />
                </StackPanel>
            </Grid>
            <Border Margin="0,12,0,0" Style="{StaticResource QuietCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="EndpointPreferenceStateText"
                               Text="OPTIONAL"
                               Foreground="{StaticResource QuietTextBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource FontMicro}"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="EndpointPreferenceDetailText"
                               Grid.Column="1"
                               Margin="12,0,0,0"
                               Text="No fallback reminders saved. Windows remains the owner of system default selection."
                               Foreground="{StaticResource QuietTextBrush}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Playback" />
                            <TextBlock x:Name="PlaybackCountText"
                                       Grid.Column="1"
                                       Text="0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMono}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Margin="0,4,0,14"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="Render endpoints, connected first." />
                        <ItemsControl x:Name="PlaybackItems" ItemTemplate="{StaticResource AudioEndpointTemplate}" />
                        <TextBlock x:Name="NoPlaybackText"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="No active playback endpoint was observed." />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Recording" />
                            <TextBlock x:Name="RecordingCountText"
                                       Grid.Column="1"
                                       Text="0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMono}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Margin="0,4,0,14"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="Capture endpoints, connected first." />
                        <ItemsControl x:Name="RecordingItems" ItemTemplate="{StaticResource AudioEndpointTemplate}" />
                        <TextBlock x:Name="NoRecordingText"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="No active recording endpoint was observed." />
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="MoreEndpointsPanel"
                    Margin="0,16,0,0"
                    Visibility="Collapsed"
                    Style="{StaticResource QuietCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="More playback" />
                            <TextBlock x:Name="MorePlaybackCountText"
                                       Grid.Column="1"
                                       Text="0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontFamily="{StaticResource MonoFont}" />
                        </Grid>
                        <ItemsControl x:Name="MorePlaybackItems"
                                      ItemTemplate="{StaticResource AudioEndpointTemplate}"
                                      AutomationProperties.Name="Additional playback endpoints" />
                        <TextBlock x:Name="NoMorePlaybackText"
                                   Text="No additional playback endpoints."
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="More recording" />
                            <TextBlock x:Name="MoreRecordingCountText"
                                       Grid.Column="1"
                                       Text="0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontFamily="{StaticResource MonoFont}" />
                        </Grid>
                        <ItemsControl x:Name="MoreRecordingItems"
                                      ItemTemplate="{StaticResource AudioEndpointTemplate}"
                                      AutomationProperties.Name="Additional recording endpoints" />
                        <TextBlock x:Name="NoMoreRecordingText"
                                   Text="No additional recording endpoints."
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="4" Margin="2,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="MixerProvenanceText"
                           Foreground="{StaticResource QuietTextBrush}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="{StaticResource FontMicro}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="App volume and mute are the only direct audio writes. Windows owns default-device selection; Soltex does not route signal, create virtual devices, or apply EQ or effects."
                           Text="Waiting for the first audio observation" />
                <TextBlock Grid.Column="1" Margin="14,0,0,0" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontCaption}" Text="Core Audio · read-back confirmed" />
            </Grid>
    </Grid>
</UserControl>
