<UserControl x:Class="Soltex.App.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Applications" />
                <TextBlock Margin="0,3,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="Installed software, startup entries, and Windows services." />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
                <Button x:Name="RefreshInventoryButton"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButton}"
                        Content="Refresh"
                        AutomationProperties.Name="Refresh application inventory"
                        Click="Refresh_Click" />
                <Border Style="{StaticResource StatusPillStyle}"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="InventoryStateDot"
                                 Width="7"
                                 Height="7"
                                 Fill="{StaticResource WarningBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="InventoryStateText"
                                   Margin="8,0,0,0"
                                   Text="WAITING"
                                   Foreground="{StaticResource WarningBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="{StaticResource FontMicro}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <Button x:Name="InstalledTabButton"
                        Tag="Selected"
                        MinWidth="92"
                        Style="{StaticResource TabButtonStyle}"
                        Content="Installed"
                        AutomationProperties.Name="Show installed applications"
                        Click="InstalledTab_Click" />
                <Button x:Name="StartupTabButton"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        MinWidth="92"
                        Style="{StaticResource TabButtonStyle}"
                        Content="Startup"
                        AutomationProperties.Name="Show startup applications"
                        Click="StartupTab_Click" />
                <Button x:Name="ServicesTabButton"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        MinWidth="92"
                        Style="{StaticResource TabButtonStyle}"
                        Content="Services"
                        AutomationProperties.Name="Show read-only Windows services"
                        Click="ServicesTab_Click" />
                <TextBlock x:Name="InventorySummaryText"
                           Grid.Column="3"
                           Margin="16,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontCaption}"
                           TextTrimming="CharacterEllipsis"
                           Text="Waiting for supported Windows sources." />
                <Grid Grid.Column="4">
                    <TextBox x:Name="InventorySearchBox"
                             Height="38"
                             Style="{StaticResource FieldStyle}"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="Search the visible application, startup, or service inventory"
                             TextChanged="InventorySearch_TextChanged" />
                    <TextBlock x:Name="SearchHintText"
                               Margin="14,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="{StaticResource FontCaption}"
                               IsHitTestVisible="False"
                               Text="Search this view" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Style="{StaticResource WorkbenchStyle}"
                Padding="0"
                ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="InstalledGrid"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          AutomationProperties.Name="Installed applications">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.5*" />
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="1*" />
                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="1*" />
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid x:Name="StartupGrid"
                          Visibility="Collapsed"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          AutomationProperties.Name="Startup applications">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Entry" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="1*" />
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="1.4*" />
                        <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="1.2*" />
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid x:Name="ServicesGrid"
                          Visibility="Collapsed"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          AutomationProperties.Name="Read-only Windows services">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Service" Binding="{Binding DisplayName}" Width="2*" />
                        <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="1*" />
                        <DataGridTextColumn Header="Start" Binding="{Binding StartMode}" Width="1*" />
                        <DataGridTextColumn x:Name="ServiceAttentionColumn"
                                            Header="Attention"
                                            Binding="{Binding Signal}"
                                            Visibility="Collapsed"
                                            Width="1*" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="InventoryEmptyText"
                           Visibility="Collapsed"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="{StaticResource FontBody}"
                           Text="No installed applications match your search." />
            </Grid>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="InventoryProvenanceText"
                       Foreground="{StaticResource QuietTextBrush}"
                       FontSize="{StaticResource FontCaption}"
                       TextTrimming="CharacterEllipsis"
                       Text="Waiting for a bounded Windows inventory." />
            <TextBlock x:Name="InventoryCoverageText"
                       Grid.Column="1"
                       Margin="14,0,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="{StaticResource FontMicro}"
                       Text="READ ONLY" />
        </Grid>
    </Grid>
</UserControl>
