<UserControl x:Class="Soltex.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="Preferences" />
                <TextBlock Margin="0,5,0,0"
                           Style="{StaticResource PageTitleStyle}"
                           Text="Settings" />
                <TextBlock Margin="0,5,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           FontSize="{StaticResource FontBody}"
                           Text="Choose how the local workspace refreshes, remembers, and records." />
            </StackPanel>
            <Border Grid.Column="1"
                    Style="{StaticResource StatusPillStyle}"
                    VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="SettingsStateDot"
                             Width="7"
                             Height="7"
                             Fill="{StaticResource SignalBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="SettingsStateText"
                               Margin="8,0,0,0"
                               Text="LOCAL"
                               Foreground="{StaticResource SignalBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource FontMicro}"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="980"
                        HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource SectionTitleStyle}"
                           Text="Performance" />
                <Border Margin="0,8,0,0"
                        Style="{StaticResource CardStyle}"
                        Padding="0">
                    <StackPanel>
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel MaxWidth="460" HorizontalAlignment="Left">
                                <TextBlock FontSize="{StaticResource FontBody}"
                                           FontWeight="SemiBold"
                                           Text="System refresh cadence" />
                                <TextBlock Margin="0,5,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="{StaticResource FontCaption}"
                                           TextWrapping="Wrap"
                                           Text="Controls live CPU, memory, network, storage, and process observation while Soltex is open." />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="24,0,0,0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button x:Name="LiveCadenceButton"
                                        MinWidth="86"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Live · 1 s"
                                        AutomationProperties.Name="Use one second system refresh cadence"
                                        Click="LiveCadence_Click" />
                                <Button x:Name="BalancedCadenceButton"
                                        Margin="8,0,0,0"
                                        MinWidth="110"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Balanced · 2 s"
                                        AutomationProperties.Name="Use two second system refresh cadence"
                                        Click="BalancedCadence_Click" />
                                <Button x:Name="QuietCadenceButton"
                                        Margin="8,0,0,0"
                                        MinWidth="90"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Quiet · 5 s"
                                        AutomationProperties.Name="Use five second system refresh cadence"
                                        Click="QuietCadence_Click" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1"
                                Background="{StaticResource TrackBrush}" />
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                                <TextBlock FontSize="{StaticResource FontBody}"
                                           FontWeight="SemiBold"
                                           Text="Open Performance details by default" />
                                <TextBlock Margin="0,5,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="{StaticResource FontCaption}"
                                           TextWrapping="Wrap"
                                           Text="Shows volumes, provider coverage, and the process table when Performance opens." />
                            </StackPanel>
                            <Button x:Name="PerformanceDetailsButton"
                                    Grid.Column="1"
                                    MinWidth="74"
                                    Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Toggle Performance details default"
                                    Click="PerformanceDetails_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,18,0,0"
                           Style="{StaticResource SectionTitleStyle}"
                           Text="Workspace" />
                <Border Margin="0,8,0,0"
                        Style="{StaticResource CardStyle}"
                        Padding="0">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                            <TextBlock FontSize="{StaticResource FontBody}"
                                       FontWeight="SemiBold"
                                       Text="Restore the last workspace" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="{StaticResource FontCaption}"
                                       TextWrapping="Wrap"
                                       Text="Returns to the most recent working module after a normal close." />
                        </StackPanel>
                        <Button x:Name="RestoreWorkspaceButton"
                                Grid.Column="1"
                                MinWidth="74"
                                Style="{StaticResource SecondaryButton}"
                                AutomationProperties.Name="Toggle restoring the last workspace"
                                Click="RestoreWorkspace_Click" />
                    </Grid>
                </Border>

                <TextBlock Margin="0,18,0,0"
                           Style="{StaticResource SectionTitleStyle}"
                           Text="Window behavior" />
                <Border Margin="0,8,0,0"
                        Style="{StaticResource CardStyle}"
                        Padding="0">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                            <TextBlock FontSize="{StaticResource FontBody}"
                                       FontWeight="SemiBold"
                                       Text="When the window closes" />
                            <TextBlock x:Name="NotificationAreaDetailText"
                                       Margin="0,5,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="{StaticResource FontCaption}"
                                       TextWrapping="Wrap"
                                       Text="Exit ends the Soltex process. Notification-area mode is opt-in." />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="24,0,0,0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="ExitOnCloseButton"
                                    MinWidth="78"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Exit"
                                    AutomationProperties.Name="Exit Soltex when its window closes"
                                    Click="ExitOnClose_Click" />
                            <Button x:Name="NotificationAreaButton"
                                    Margin="8,0,0,0"
                                    MinWidth="146"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Notification area"
                                    AutomationProperties.Name="Keep Soltex in the notification area when its window closes"
                                    Click="NotificationArea_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Margin="0,18,0,0"
                           Style="{StaticResource SectionTitleStyle}"
                           Text="Activity" />
                <Border Margin="0,8,0,0"
                        Style="{StaticResource CardStyle}"
                        Padding="0">
                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel MaxWidth="510" HorizontalAlignment="Left">
                            <TextBlock FontSize="{StaticResource FontBody}"
                                       FontWeight="SemiBold"
                                       Text="Keep recent activity" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="{StaticResource FontCaption}"
                                       TextWrapping="Wrap"
                                       Text="Records only meaningful Soltex actions and state changes. Entries are sanitized and bounded to 120." />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="24,0,0,0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="SessionActivityButton"
                                    MinWidth="92"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Session"
                                    AutomationProperties.Name="Keep activity for this session only"
                                    Click="SessionActivity_Click" />
                            <Button x:Name="SevenDayActivityButton"
                                    Margin="8,0,0,0"
                                    MinWidth="82"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="7 days"
                                    AutomationProperties.Name="Keep activity for seven days"
                                    Click="SevenDayActivity_Click" />
                            <Button x:Name="ThirtyDayActivityButton"
                                    Margin="8,0,0,0"
                                    MinWidth="88"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="30 days"
                                    AutomationProperties.Name="Keep activity for thirty days"
                                    Click="ThirtyDayActivity_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Margin="0,18,0,0"
                           Style="{StaticResource SectionTitleStyle}"
                           Text="Runtime boundaries" />
                <Border Margin="0,8,0,0"
                        Style="{StaticResource QuietCardStyle}"
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Preferences stay on this Windows account." />
                        <TextBlock Grid.Column="1"
                                   Foreground="{StaticResource SignalBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="{StaticResource FontMicro}"
                                   Text="ON DEVICE" />
                        <TextBlock Grid.Row="2"
                                   Text="Performance sampling pauses when minimized or hidden." />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="{StaticResource FontMicro}"
                                   Text="SUSPENDS" />
                        <TextBlock x:Name="BackgroundRuntimeText"
                                   Grid.Row="4"
                                   Text="Closing Soltex ends this desktop process; no service is installed." />
                        <TextBlock x:Name="BackgroundRuntimeStateText"
                                   Grid.Row="4"
                                   Grid.Column="1"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="{StaticResource FontMicro}"
                                   Text="EXIT" />
                    </Grid>
                </Border>

                <Grid Margin="0,18,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SettingsSaveDetailText"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="{StaticResource FontCaption}"
                               Text="Preferences are ready." />
                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Content="Reset defaults"
                            AutomationProperties.Name="Reset Soltex preferences to defaults"
                            Click="ResetDefaults_Click" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
