<UserControl x:Class="Soltex.App.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="640"
             MinHeight="500"
             Background="Transparent"
             Foreground="{DynamicResource TextBrush}"
             FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Margin="0,2,22,2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="SOLTEX" Style="{StaticResource PageEyebrowStyle}" />
                <TextBlock Margin="0,5,0,0"
                           Text="Set up Soltex"
                           Foreground="{DynamicResource TextBrightBrush}"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,7,0,0"
                           Text="Seven short decisions. Nothing is enabled silently."
                           Foreground="{DynamicResource QuietTextBrush}"
                           FontSize="{StaticResource FontCaption}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <ItemsControl x:Name="ProgressItems" Grid.Row="2" AutomationProperties.Name="Setup progress">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="18"
                                    Height="18"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource QuietBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <TextBlock Text="{Binding Number}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource QuietTextBrush}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="9" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="{StaticResource FontCaption}"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,2,0,0"
                                           Text="{Binding StateLabel}"
                                           Foreground="{DynamicResource QuietTextBrush}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="{StaticResource FontMicro}" />
                            </StackPanel>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StateLabel}" Value="CURRENT">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StateLabel}" Value="REVIEWED">
                                            <Setter Property="Opacity" Value="0.72" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StateLabel}" Value="PENDING">
                                            <Setter Property="Opacity" Value="0.48" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="3"
                       Text="Esc closes setup without claiming completion."
                       Foreground="{DynamicResource QuietTextBrush}"
                       FontSize="{StaticResource FontMicro}"
                       TextWrapping="Wrap" />
        </Grid>

        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

        <Grid Grid.Column="2" Margin="28,2,0,2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="StepEyebrow" Style="{StaticResource PageEyebrowStyle}" />
                    <TextBlock x:Name="StepTitle"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource TextBrightBrush}"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="26"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Border x:Name="CapabilityPill"
                        Grid.Column="1"
                        Margin="18,0,0,0"
                        Padding="10,5"
                        VerticalAlignment="Top"
                        Background="{DynamicResource QuietBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusPill}">
                    <TextBlock x:Name="CapabilityStateText"
                               Foreground="{DynamicResource MutedBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource FontMicro}"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="StepDetail"
                               MaxWidth="650"
                               HorizontalAlignment="Left"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="15"
                               LineHeight="23"
                               TextWrapping="Wrap" />

                    <Border Margin="0,20,0,0"
                            Padding="14"
                            Background="{DynamicResource QuietBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE946;"
                                       FontFamily="{StaticResource IconFont}"
                                       Foreground="{DynamicResource AccentFocusBrush}"
                                       FontSize="15" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="SAFE DEFAULT"
                                           Foreground="{DynamicResource QuietTextBrush}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="{StaticResource FontMicro}"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="SafeDefaultText"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="{StaticResource FontBody}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Margin="0,12,0,0"
                            Padding="14"
                            Background="{DynamicResource InsetBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMd}">
                        <StackPanel>
                            <TextBlock Text="CURRENT CAPABILITY"
                                       Foreground="{DynamicResource QuietTextBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMicro}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="CapabilityDetailText"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="{StaticResource FontBody}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="CapabilityActionText"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource QuietTextBrush}"
                                       FontSize="{StaticResource FontCaption}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="AppearanceOptions"
                                Margin="0,20,0,0"
                                Visibility="Collapsed">
                        <TextBlock Text="APP THEME" Style="{StaticResource PageEyebrowStyle}" />
                        <UniformGrid Margin="0,8,0,0" Columns="3">
                            <Button x:Name="SystemThemeButton" Margin="0,0,6,0" Style="{StaticResource SecondaryButton}" Content="System" Click="SystemTheme_Click" />
                            <Button x:Name="LightThemeButton" Margin="3,0" Style="{StaticResource SecondaryButton}" Content="Light" Click="LightTheme_Click" />
                            <Button x:Name="DarkThemeButton" Margin="6,0,0,0" Style="{StaticResource SecondaryButton}" Content="Dark" Click="DarkTheme_Click" />
                        </UniformGrid>
                        <TextBlock Margin="0,16,0,0" Text="INTERACTION ACCENT" Style="{StaticResource PageEyebrowStyle}" />
                        <UniformGrid Margin="0,8,0,0" Columns="2">
                            <Button x:Name="GlacierAccentButton" Margin="0,0,5,0" Style="{StaticResource SecondaryButton}" Content="Soltex Glacier" Click="GlacierAccent_Click" />
                            <Button x:Name="WindowsAccentButton" Margin="5,0,0,0" Style="{StaticResource SecondaryButton}" Content="Windows accent" Click="WindowsAccent_Click" />
                        </UniformGrid>
                        <TextBlock Margin="0,16,0,0" Text="DENSITY" Style="{StaticResource PageEyebrowStyle}" />
                        <UniformGrid Margin="0,8,0,0" Columns="2">
                            <Button x:Name="ComfortableDensityButton" Margin="0,0,5,0" Style="{StaticResource SecondaryButton}" Content="Comfortable" Click="ComfortableDensity_Click" />
                            <Button x:Name="CompactDensityButton" Margin="5,0,0,0" Style="{StaticResource SecondaryButton}" Content="Compact" Click="CompactDensity_Click" />
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton"
                        MinWidth="86"
                        Style="{StaticResource SecondaryButton}"
                        Content="Back"
                        Click="Back_Click" />
                <Button Grid.Column="2"
                        MinWidth="94"
                        Style="{StaticResource SecondaryButton}"
                        Content="Not now"
                        AutomationProperties.Name="Close setup without completing it"
                        Click="NotNow_Click" />
                <Button x:Name="ContinueButton"
                        Grid.Column="4"
                        MinWidth="112"
                        Style="{StaticResource ActionButton}"
                        Content="Continue"
                        Click="Continue_Click" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
