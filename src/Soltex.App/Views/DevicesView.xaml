<UserControl x:Class="Soltex.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="DEVICE MESH / PREVIEW" />
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource PageTitleStyle}" Text="Device mesh" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource MutedTextStyle}"
                               FontSize="14"
                               Text="This PC is visible locally. Secure enrollment and remote jobs are not enabled yet." />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource StatusPillStyle}" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0"
                                   Text="LOCAL ONLY"
                                   Foreground="{StaticResource WarningBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="10"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="DeviceHeroCard" Margin="0,20,0,0" Style="{StaticResource HeroCardStyle}" Height="220">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="THIS WINDOWS PC" Style="{StaticResource PageEyebrowStyle}" Foreground="{StaticResource SignalBrush}" />
                        <TextBlock x:Name="DeviceNameText" Margin="0,8,0,0" Text="Local machine" FontFamily="{StaticResource DisplayFont}" FontSize="36" />
                        <TextBlock x:Name="DeviceOsText" Margin="0,7,0,0" Text="Reading Windows profile…" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <StackPanel Margin="0,19,0,0" Orientation="Horizontal">
                            <Border Style="{StaticResource StatusPillStyle}" Background="{StaticResource SignalQuietBrush}" BorderBrush="{StaticResource SignalBorderBrush}">
                                <TextBlock x:Name="ObservationStateText" Text="OBSERVING" Foreground="{StaticResource SignalBrush}" FontFamily="{StaticResource MonoFont}" FontSize="9" />
                            </Border>
                            <Border Margin="8,0,0,0" Style="{StaticResource StatusPillStyle}">
                                <TextBlock Text="NOT ENROLLED" Foreground="{StaticResource WarningBrush}" FontFamily="{StaticResource MonoFont}" FontSize="9" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="DeviceProfileCard" Grid.Column="1" Background="{StaticResource QuietBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="18">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="OS architecture" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="OsArchitectureText" Grid.Column="1" Text="—" FontFamily="{StaticResource MonoFont}" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Process" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="ProcessArchitectureText" Grid.Column="1" Text="—" FontFamily="{StaticResource MonoFont}" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Agent" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Column="1" Text="NONE" Foreground="{StaticResource WarningBrush}" FontFamily="{StaticResource MonoFont}" FontSize="9" />
                            </Grid>
                            <TextBlock x:Name="FrameworkText" Margin="0,5,0,0" Foreground="{StaticResource QuietTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="9" TextWrapping="Wrap" Text="Runtime unavailable" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="No connected devices" />
                        <TextBlock Margin="0,5,0,14"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   LineHeight="19"
                                   Text="Soltex has no listener, discovery transport, shared password, background agent, or NAS permission authority. Future devices must advertise an exact manifest and remain independently authorized." />
                        <Grid Background="{StaticResource QuietBrush}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="13,11">
                                <TextBlock Text="Private mesh" FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="Tailscale-compatible transport is a documented future boundary."
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Margin="13" Text="NOT CONFIGURED" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="9" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource QuietCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Visible remote handoff" />
                        <TextBlock Margin="0,5,0,14"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   LineHeight="19"
                                   Text="RustDesk stays an external, user-selected client with signature checking and visible per-session consent." />
                        <Button Style="{StaticResource SecondaryButton}" Click="OpenRemoteAssist_Click" Content="Review Remote Assist" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Margin="0,16,0,0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Planned device actions" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedTextStyle}" Text="Reviewed action shapes are visible here before enrollment is enabled." />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="PREVIEW" Foreground="{StaticResource WarningBrush}" FontFamily="{StaticResource MonoFont}" FontSize="9" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl x:Name="CapabilityItems" Margin="0,16,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,10,10"
                                        Background="{StaticResource QuietBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="13">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,5,0,0" Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" LineHeight="15" />
                                        <Grid Margin="0,11,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Effect}" Foreground="{StaticResource QuietTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="8" />
                                            <TextBlock Grid.Column="1" Text="{Binding Approval}" Foreground="{StaticResource WarningBrush}" FontFamily="{StaticResource MonoFont}" FontSize="8" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="DeviceProvenanceText"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource QuietTextBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="9"
                               TextWrapping="Wrap"
                               Text="Waiting for local profile provenance" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
