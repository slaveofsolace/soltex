<UserControl x:Class="Soltex.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Foreground="{DynamicResource TextBrush}"
             FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="210" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Device mesh" />
                <TextBlock Margin="0,3,0,0" Style="{StaticResource MutedTextStyle}" Text="Local profile today; enrollment and remote jobs remain preview-only." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Margin="0,0,8,0" Style="{StaticResource StatusPillStyle}">
                    <TextBlock Text="PREVIEW" Foreground="{DynamicResource WarningBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" />
                </Border>
                <Border Style="{StaticResource StatusPillStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" Text="LOCAL ONLY" Foreground="{DynamicResource WarningBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border x:Name="DeviceHeroCard" Grid.Row="2" Style="{StaticResource HeroCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                    <TextBlock Text="This Windows PC" Foreground="{DynamicResource SignalBrush}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" />
                    <TextBlock x:Name="DeviceNameText" Margin="0,7,0,0" Text="Local machine" FontFamily="{StaticResource DisplayFont}" FontSize="32" />
                    <TextBlock x:Name="DeviceOsText" Margin="0,5,0,0" Text="Reading Windows profile…" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                    <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                        <Border Style="{StaticResource StatusPillStyle}" Background="{DynamicResource SignalQuietBrush}" BorderBrush="{DynamicResource SignalBorderBrush}">
                            <TextBlock x:Name="ObservationStateText" Text="OBSERVING" Foreground="{DynamicResource SignalBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" />
                        </Border>
                        <Border Margin="8,0,0,0" Style="{StaticResource StatusPillStyle}">
                            <TextBlock Text="NOT ENROLLED" Foreground="{DynamicResource WarningBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Border x:Name="DeviceProfileCard" Grid.Column="1" Background="{DynamicResource QuietBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="14">
                    <StackPanel VerticalAlignment="Center">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="OS architecture" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock x:Name="OsArchitectureText" Grid.Column="1" Text="—" FontFamily="{StaticResource MonoFont}" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Process" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock x:Name="ProcessArchitectureText" Grid.Column="1" Text="—" FontFamily="{StaticResource MonoFont}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Agent" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Grid.Column="1" Text="NONE" Foreground="{DynamicResource WarningBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" />
                        </Grid>
                        <TextBlock x:Name="FrameworkText" Margin="0,10,0,0" Foreground="{DynamicResource QuietTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" TextTrimming="CharacterEllipsis" Text="Runtime unavailable" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource WorkbenchStyle}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                <Grid Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Connected devices" />
                    <TextBlock Grid.Row="2" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Text="No enrolled device. Soltex has no listener, shared password, background agent, or NAS authority." />
                    <StackPanel Grid.Row="4" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Click="OpenRemoteAssist_Click" Content="Remote Assist" />
                        <Border Margin="10,0,0,0" Style="{StaticResource StatusPillStyle}">
                            <TextBlock Text="PRIVATE MESH NOT CONFIGURED" Foreground="{DynamicResource MutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" />
                        </Border>
                    </StackPanel>
                </Grid>
                <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />
                <Grid Grid.Column="2" Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Planned actions" />
                        <TextBlock Grid.Column="1" Text="PREVIEW" Foreground="{DynamicResource WarningBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" />
                    </Grid>
                    <ItemsControl x:Name="CapabilityItems" Grid.Row="2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,3,0,0" Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="{StaticResource FontCaption}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Effect}" Foreground="{DynamicResource QuietTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" HorizontalAlignment="Right" />
                                        <TextBlock Margin="0,3,0,0" Text="{Binding Approval}" Foreground="{DynamicResource WarningBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Border>

        <TextBlock x:Name="DeviceProvenanceText" Grid.Row="6" Margin="2,0" Foreground="{DynamicResource QuietTextBrush}" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontMicro}" TextTrimming="CharacterEllipsis" Text="Waiting for local profile provenance" />
    </Grid>
</UserControl>
