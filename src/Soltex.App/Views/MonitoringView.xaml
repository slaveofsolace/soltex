<UserControl x:Class="Soltex.App.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Soltex.App.Controls"
             Background="Transparent"
             Foreground="{StaticResource TextBrush}"
             FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

            <!-- Page header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Performance" />
                    <TextBlock x:Name="PerformanceSubtitleText"
                               Margin="0,3,0,0"
                               Style="{StaticResource MutedTextStyle}"
                               Text="Live CPU, memory, network, storage, and process activity." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="BenchmarkModeButton"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButton}"
                            Content="Benchmark"
                            AutomationProperties.Name="Open quick local benchmark"
                            Click="BenchmarkMode_Click" />
                    <Button x:Name="MonitoringDetailsButton"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButton}"
                            Content="Show system detail"
                            AutomationProperties.Name="Show storage, provider, and process details"
                            Click="MonitoringDetails_Click" />
                    <Border Style="{StaticResource StatusPillStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="MonitorStateDot"
                                     Width="7"
                                     Height="7"
                                     Fill="{StaticResource WarningBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="MonitorStateText"
                                       Margin="8,0,0,0"
                                       Text="WAITING"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMono}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="MonitoringOverviewPanel" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="248" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

            <!-- Processor and physical memory -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource HeroCardStyle}" MinHeight="248">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Processor" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold" />
                            <TextBlock x:Name="CpuDetailText"
                                       Grid.Column="1"
                                       Text="GetSystemTimes"
                                       Foreground="{StaticResource QuietTextBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMicro}" />
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    Margin="0,4,0,0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom">
                            <TextBlock x:Name="CpuValueText"
                                       Text="—"
                                       Style="{StaticResource MetricValueStyle}"
                                       FontSize="50" />
                            <TextBlock Margin="10,0,0,8" Text="total CPU" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>

                        <controls:Sparkline x:Name="CpuHistoryChart"
                                            Grid.Row="2"
                                            Margin="0,8,0,6"
                                            MinHeight="76"
                                            Stroke="{StaticResource AccentBrush}"
                                            Fill="{StaticResource AccentAreaBrush}"
                                            GridBrush="{StaticResource BorderBrush}"
                                            GridLineCount="3"
                                            ShowLastPoint="True"
                                            StrokeThickness="2.2"
                                            ShowScaleLabels="True"
                                            ScaleLabelBrush="{StaticResource QuietTextBrush}"
                                            AutomationProperties.Name="Recent CPU utilization" />

                        <Grid Grid.Row="3" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CpuStatsText"
                                       Grid.Column="1"
                                       Text="awaiting samples"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMicro}" />
                        </Grid>

                        <TextBlock x:Name="CpuWindowText"
                                   Grid.Row="4"
                                   Text="up to 72 samples"
                                   Foreground="{StaticResource QuietTextBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="{StaticResource FontMicro}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}" MinHeight="248">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Physical memory"
                                       Foreground="{StaticResource SignalBrush}"
                                       FontSize="{StaticResource FontCaption}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="MemoryDetailText"
                                       Grid.Column="1"
                                       Text="GlobalMemoryStatusEx"
                                       Foreground="{StaticResource QuietTextBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMicro}" />
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    Margin="0,4,0,0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom">
                            <TextBlock x:Name="MemoryValueText"
                                       Text="—"
                                       Style="{StaticResource MetricValueStyle}"
                                       FontSize="50" />
                            <TextBlock Margin="10,0,0,8" Text="in use" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>

                        <controls:Sparkline x:Name="MemoryHistoryChart"
                                            Grid.Row="2"
                                            Margin="0,8,0,6"
                                            MinHeight="76"
                                            Stroke="{StaticResource SignalBrush}"
                                            Fill="{StaticResource SignalAreaBrush}"
                                            GridBrush="{StaticResource BorderBrush}"
                                            GridLineCount="3"
                                            ShowLastPoint="True"
                                            StrokeThickness="2.2"
                                            ShowScaleLabels="True"
                                            ScaleLabelBrush="{StaticResource QuietTextBrush}"
                                            AutomationProperties.Name="Recent physical memory utilization" />

                        <Grid Grid.Row="3" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="MemoryCapacityText"
                                       Text="Capacity unavailable"
                                       Foreground="{StaticResource QuietTextBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMicro}" />
                            <TextBlock x:Name="MemoryStatsText"
                                       Grid.Column="1"
                                       Text="awaiting samples"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMicro}" />
                        </Grid>

                        <!-- Commit charge: reserved backing store, which can exceed installed RAM. -->
                        <Grid Grid.Row="4" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Commit"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="{StaticResource FontCaption}"
                                       VerticalAlignment="Center" />
                            <ProgressBar x:Name="CommitProgress"
                                         Grid.Column="1"
                                         Margin="10,0"
                                         Maximum="100"
                                         Style="{StaticResource MetricProgressStyle}"
                                         VerticalAlignment="Center"
                                         AutomationProperties.Name="System commit charge in use" />
                            <TextBlock x:Name="CommitText"
                                       Grid.Column="2"
                                       Text="—"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMicro}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Network throughput -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Network throughput" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="Aggregate rates from stable active Windows interfaces." />
                            </StackPanel>
                            <TextBlock x:Name="NetworkCoverageText"
                                       Grid.Column="1"
                                       Text="WAITING"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMicro}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock x:Name="NetworkTotalText"
                                           Text="—"
                                           Style="{StaticResource MetricValueStyle}"
                                           FontSize="{StaticResource FontMetric}" />
                                <TextBlock x:Name="NetworkInterfaceCountText"
                                           Margin="12,0,0,6"
                                           Text="0 stable interfaces"
                                           Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Width="10"
                                            Height="2"
                                            Margin="0,0,6,0"
                                            Background="{StaticResource SignalBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock x:Name="NetworkReceiveText"
                                               Text="Receive unavailable"
                                               Foreground="{StaticResource SignalBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="{StaticResource FontMono}" />
                                </StackPanel>
                                <StackPanel Margin="0,4,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Width="10"
                                            Height="2"
                                            Margin="0,0,6,0"
                                            Background="{StaticResource AccentBrush}"
                                            VerticalAlignment="Center" />
                                    <TextBlock x:Name="NetworkSendText"
                                               Text="Send unavailable"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="{StaticResource FontMono}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <controls:Sparkline x:Name="NetworkHistoryChart"
                                            Grid.Row="2"
                                            Margin="0,12,0,0"
                                            Height="86"
                                            AutoScale="True"
                                            Stroke="{StaticResource SignalBrush}"
                                            Fill="{StaticResource SignalAreaBrush}"
                                            ComparisonStroke="{StaticResource AccentBrush}"
                                            GridBrush="{StaticResource BorderBrush}"
                                            GridLineCount="3"
                                            ShowLastPoint="True"
                                            StrokeThickness="2.2"
                                            ShowScaleLabels="True"
                                            ScaleLabelBrush="{StaticResource QuietTextBrush}"
                                            AutomationProperties.Name="Recent network receive and send throughput" />

                        <TextBlock x:Name="NetworkScaleText"
                                   Grid.Row="3"
                                   Margin="0,6,0,0"
                                   Text="Autoscaled to the observed peak"
                                   Foreground="{StaticResource QuietTextBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="{StaticResource FontMicro}" />
                    </Grid>

                    <Border Grid.Column="2" Style="{StaticResource QuietCardStyle}" Padding="14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Active interfaces" />
                            <ItemsControl x:Name="NetworkInterfaceItems" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Type}"
                                                           Foreground="{StaticResource QuietTextBrush}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="{StaticResource FontMicro}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Rate}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="{StaticResource FontMono}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding Split}"
                                                           Foreground="{StaticResource QuietTextBrush}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="{StaticResource FontMicro}"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoInterfacesText"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="{StaticResource FontCaption}"
                                       TextWrapping="Wrap"
                                       Text="No stable active interface was observed." />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            </Grid>

            <Grid x:Name="MonitoringDetailsPanel" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
            <!-- Volumes and provider coverage -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Fixed volumes" />
                            <TextBlock x:Name="VolumeCountText"
                                       Grid.Column="1"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="0 observed" />
                        </Grid>
                        <ItemsControl x:Name="VolumeItems" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="146" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" />
                                        <ProgressBar Grid.Column="1"
                                                     Margin="10,0"
                                                     Maximum="100"
                                                     Value="{Binding UsedPercent, Mode=OneWay}"
                                                     Style="{StaticResource MetricProgressStyle}"
                                                     Foreground="{StaticResource SignalBrush}"
                                                     VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Detail}"
                                                   HorizontalAlignment="Right"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="{StaticResource FontMono}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoVolumesText"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="No ready fixed volume was observed." />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource QuietCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Provider coverage" />
                        <TextBlock Margin="0,4,0,15"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="Unsupported data stays explicit." />
                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CPU · memory · commit" />
                            <TextBlock Grid.Column="1"
                                       Text="SUPPORTED"
                                       Foreground="{StaticResource SignalBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMicro}" />
                        </Grid>
                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Processes · volumes" />
                            <TextBlock Grid.Column="1"
                                       Text="BOUNDED"
                                       Foreground="{StaticResource SignalBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMicro}" />
                        </Grid>
                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Network throughput" />
                            <TextBlock Grid.Column="1"
                                       Text="CONDITIONAL"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMicro}" />
                        </Grid>
                        <Grid Margin="0,0,0,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Per-core CPU" />
                            <TextBlock Grid.Column="1"
                                       Text="NOT SAMPLED"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMicro}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GPU · disk I/O" />
                            <TextBlock Grid.Column="1"
                                       Text="UNAVAILABLE"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMicro}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Processes -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Active processes" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="Name and PID only; executable paths are intentionally omitted." />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="ProcessCountText"
                                       Margin="0,0,12,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center"
                                       Text="0 rows" />
                            <Button x:Name="EndTaskButton"
                                    IsEnabled="False"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="End task"
                                    AutomationProperties.Name="End selected task"
                                    Click="EndTask_Click" />
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="ProcessGrid"
                              Grid.Row="2"
                              SelectionMode="Single"
                              SelectionChanged="ProcessGrid_SelectionChanged"
                              AlternationCount="2"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              AutomationProperties.Name="Active process telemetry">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="85" />
                            <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="90" />
                            <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="110" />
                            <DataGridTextColumn Header="Threads" Binding="{Binding Threads}" Width="88" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="ProcessActionPanel"
                            Grid.Row="3"
                            Margin="0,12,0,0"
                            Padding="12"
                            Style="{StaticResource QuietCardStyle}"
                            Visibility="Collapsed"
                            AutomationProperties.LiveSetting="Polite">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProcessActionText"
                                       Margin="0,0,14,0"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button x:Name="ForceStopButton"
                                    Grid.Column="1"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Foreground="{StaticResource DangerBrush}"
                                    BorderBrush="{StaticResource DangerBrush}"
                                    Content="Force stop"
                                    AutomationProperties.Name="Confirm force stop selected task"
                                    Visibility="Collapsed"
                                    Click="ForceStop_Click" />
                            <Button x:Name="CancelEndTaskButton"
                                    Grid.Column="2"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Dismiss"
                                    AutomationProperties.Name="Dismiss process action"
                                    Click="CancelEndTask_Click" />
                        </Grid>
                    </Border>

                    <TextBlock x:Name="MonitoringProvenanceText"
                               Grid.Row="4"
                               Margin="0,12,0,0"
                               Foreground="{StaticResource QuietTextBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="{StaticResource FontMicro}"
                               TextWrapping="Wrap"
                               Text="Waiting for provider provenance" />
                </Grid>
            </Border>
            </Grid>

            <Grid x:Name="BenchmarkPanel"
                  Grid.Row="2"
                  Visibility="Collapsed"
                  AutomationProperties.Name="Quick local benchmark">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="220" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Quick local benchmark" />
                                <Border Margin="12,0,0,0" Style="{StaticResource StatusPillStyle}">
                                    <TextBlock x:Name="BenchmarkStateText"
                                               Text="READY"
                                               Foreground="{StaticResource SignalBrush}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="{StaticResource FontMicro}"
                                               FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Margin="0,6,0,0"
                                       MaxWidth="670"
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Text="Measures named local workloads without producing a synthetic PC score or cross-machine ranking." />
                            <TextBlock Margin="0,12,0,0"
                                       Foreground="{StaticResource QuietTextBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMicro}"
                                       Text="about 4 seconds · 32 MiB scratch · cancelable · last result saved locally" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CancelBenchmarkButton"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Cancel"
                                    IsEnabled="False"
                                    AutomationProperties.Name="Cancel benchmark"
                                    Click="CancelBenchmark_Click" />
                            <Button x:Name="RunBenchmarkButton"
                                    Style="{StaticResource ActionButton}"
                                    Content="Run quick benchmark"
                                    AutomationProperties.Name="Run bounded quick benchmark"
                                    Click="RunBenchmark_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource HeroCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Processor" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                            <TextBlock x:Name="BenchmarkCpuValueText"
                                       Margin="0,18,0,0"
                                       Text="—"
                                       Style="{StaticResource MetricValueStyle}"
                                       FontSize="32" />
                            <TextBlock Text="SHA-256 throughput" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="BenchmarkCpuDetailText"
                                       Margin="0,18,0,0"
                                       Text="Not measured"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource QuietTextBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMicro}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Memory" Foreground="{StaticResource SignalBrush}" FontWeight="SemiBold" />
                            <TextBlock x:Name="BenchmarkMemoryValueText"
                                       Margin="0,18,0,0"
                                       Text="—"
                                       Style="{StaticResource MetricValueStyle}"
                                       FontSize="32" />
                            <TextBlock Text="Buffer copy throughput" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="BenchmarkMemoryDetailText"
                                       Margin="0,18,0,0"
                                       Text="Not measured"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource QuietTextBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMicro}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Temporary storage" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" />
                            <TextBlock x:Name="BenchmarkStorageValueText"
                                       Margin="0,18,0,0"
                                       Text="—"
                                       Style="{StaticResource MetricValueStyle}"
                                       FontSize="32" />
                            <TextBlock Text="Write / read throughput" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="BenchmarkStorageDetailText"
                                       Margin="0,18,0,0"
                                       Text="No scratch file created"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource QuietTextBrush}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontMicro}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="4" Style="{StaticResource QuietCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Run context" />
                            <Button x:Name="ClearBenchmarkResultButton"
                                    Grid.Column="1"
                                    IsEnabled="False"
                                    Style="{StaticResource SecondaryButton}"
                                    Content="Clear saved result"
                                    AutomationProperties.Name="Clear saved benchmark result"
                                    Click="ClearBenchmarkResult_Click" />
                        </Grid>
                        <TextBlock x:Name="BenchmarkSummaryText"
                                   Grid.Row="1"
                                   Margin="0,10,0,0"
                                   Text="Ready. Performance sampling pauses while this lab is open so it does not compete with the measured workload."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                </Border>
            </Grid>
    </Grid>
</UserControl>
