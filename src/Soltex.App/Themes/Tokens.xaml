<!--
    Soltex design tokens — the single source of truth for the visual language.

    This is the ONLY file permitted to contain raw #RRGGBB / #AARRGGBB literals.
    eng/verify-design-tokens.ps1 fails the build if a raw hex value appears in any
    other XAML file, so every surface, control, and future feature resolves its
    colour, radius, spacing, type, and motion through the tokens defined here.

    Layers, in dependency order:
      1. Colours   — raw palette primitives (the only literals).
      2. Brushes    — semantic roles that reference the colour primitives.
      3. Radii      — corner-radius scale.
      4. Spacing    — numeric gap scale and common padding thicknesses.
      5. Type       — font families and the size scale.
      6. Motion     — animation durations.

    Palette intent: a deep graphite instrument ground with high-clarity text,
    one glacier-blue interaction signal, green reserved for confirmed-good
    state, amber for attention, and red for danger. See docs/DESIGN_SYSTEM.md
    for the full rationale and usage rules.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================ -->
    <!-- 1. Colour primitives                                          -->
    <!-- ============================================================ -->

    <!-- Graphite ground, darkest to lightest. -->
    <Color x:Key="SidebarColor">#0D1116</Color>
    <Color x:Key="FieldColor">#0F141A</Color>
    <Color x:Key="InsetColor">#11171E</Color>
    <Color x:Key="CanvasColor">#0B0E12</Color>
    <Color x:Key="QuietColor">#131A21</Color>
    <Color x:Key="SurfaceColor">#171E26</Color>
    <Color x:Key="RaisedColor">#1D2630</Color>
    <Color x:Key="ElevatedColor">#24303C</Color>
    <Color x:Key="HeroBaseColor">#171E26</Color>
    <Color x:Key="TrackColor">#2B3743</Color>
    <Color x:Key="ScrollTrackColor">#11171E</Color>
    <Color x:Key="ScrollThumbColor">#536473</Color>

    <!-- Edges. -->
    <Color x:Key="BorderColor">#28333D</Color>
    <Color x:Key="BorderStrongColor">#394957</Color>
    <Color x:Key="HeroBorderColor">#33424F</Color>

    <!-- High-clarity neutral text, brightest to quietest. -->
    <Color x:Key="TextBrightColor">#FFFFFF</Color>
    <Color x:Key="TextColor">#EEF3F7</Color>
    <Color x:Key="TextSecondaryColor">#C5CFD8</Color>
    <Color x:Key="MutedColor">#92A0AD</Color>
    <Color x:Key="QuietTextColor">#687684</Color>

    <!-- Glacier-blue interaction signal. -->
    <Color x:Key="AccentColor">#67B7FF</Color>
    <Color x:Key="AccentFocusColor">#A8D6FF</Color>
    <Color x:Key="AccentDimColor">#3D7FAF</Color>
    <Color x:Key="AccentQuietColor">#10263A</Color>
    <Color x:Key="OnAccentColor">#06131C</Color>

    <!-- Green: confirmed-good only. -->
    <Color x:Key="SignalColor">#5DD39E</Color>
    <Color x:Key="SignalTextColor">#B6D8C8</Color>
    <Color x:Key="SignalSurfaceColor">#13251E</Color>
    <Color x:Key="SignalQuietColor">#162C23</Color>
    <Color x:Key="SignalBorderColor">#2E5745</Color>

    <!-- Amber attention, red danger. -->
    <Color x:Key="WarningColor">#F4BE63</Color>
    <Color x:Key="WarningSurfaceColor">#221B10</Color>
    <Color x:Key="WarningBorderColor">#6F5526</Color>
    <Color x:Key="DangerColor">#FF6B7A</Color>
    <Color x:Key="DangerTextColor">#FF9DA8</Color>
    <Color x:Key="DangerSurfaceColor">#241319</Color>
    <Color x:Key="DangerBorderColor">#74313B</Color>

    <!-- Navigation selection tint. -->
    <Color x:Key="NavSelectedColor">#10263A</Color>

    <!-- Translucent fills for chart areas and text selection (#AARRGGBB). -->
    <Color x:Key="AccentAreaColor">#2467B7FF</Color>
    <Color x:Key="SignalAreaColor">#1A5DD39E</Color>
    <Color x:Key="SelectionColor">#6067B7FF</Color>
    <Color x:Key="ModalScrimColor">#B0000509</Color>

    <!-- ============================================================ -->
    <!-- 2. Semantic brushes                                           -->
    <!-- ============================================================ -->

    <!-- Surfaces. -->
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource FieldColor}" />
    <SolidColorBrush x:Key="InsetBrush" Color="{StaticResource InsetColor}" />
    <SolidColorBrush x:Key="QuietBrush" Color="{StaticResource QuietColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}" />
    <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="{StaticResource ScrollTrackColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />

    <SolidColorBrush x:Key="HeroSurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="HeroPanelBrush" Color="{StaticResource HeroBaseColor}" />

    <!-- Edges. -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="HeroBorderBrush" Color="{StaticResource HeroBorderColor}" />

    <!-- Text. -->
    <SolidColorBrush x:Key="TextBrightBrush" Color="{StaticResource TextBrightColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="QuietTextBrush" Color="{StaticResource QuietTextColor}" />

    <!-- Accent. -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentFocusBrush" Color="{StaticResource AccentFocusColor}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="AccentQuietBrush" Color="{StaticResource AccentQuietColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />

    <!-- Status. -->
    <SolidColorBrush x:Key="SignalBrush" Color="{StaticResource SignalColor}" />
    <SolidColorBrush x:Key="SignalTextBrush" Color="{StaticResource SignalTextColor}" />
    <SolidColorBrush x:Key="SignalSurfaceBrush" Color="{StaticResource SignalSurfaceColor}" />
    <SolidColorBrush x:Key="SignalQuietBrush" Color="{StaticResource SignalQuietColor}" />
    <SolidColorBrush x:Key="SignalBorderBrush" Color="{StaticResource SignalBorderColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="{StaticResource WarningSurfaceColor}" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="{StaticResource WarningBorderColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="{StaticResource DangerTextColor}" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{StaticResource DangerSurfaceColor}" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="{StaticResource DangerBorderColor}" />

    <!-- Navigation. -->
    <SolidColorBrush x:Key="SelectedNavBrush" Color="{StaticResource NavSelectedColor}" />
    <SolidColorBrush x:Key="NavRestBrush" Color="Transparent" />

    <!-- Chart area fills and text selection. -->
    <SolidColorBrush x:Key="AccentAreaBrush" Color="{StaticResource AccentAreaColor}" />
    <SolidColorBrush x:Key="SignalAreaBrush" Color="{StaticResource SignalAreaColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
    <SolidColorBrush x:Key="ModalScrimBrush" Color="{StaticResource ModalScrimColor}" />

    <!-- ============================================================ -->
    <!-- 3. Corner-radius scale                                        -->
    <!-- ============================================================ -->
    <CornerRadius x:Key="RadiusXs">2</CornerRadius>
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">6</CornerRadius>
    <CornerRadius x:Key="RadiusHero">8</CornerRadius>
    <CornerRadius x:Key="RadiusHeroXl">10</CornerRadius>

    <!-- ============================================================ -->
    <!-- 4. Spacing scale and common paddings                          -->
    <!-- ============================================================ -->
    <sys:Double x:Key="Space2xs">4</sys:Double>
    <sys:Double x:Key="SpaceXs">6</sys:Double>
    <sys:Double x:Key="SpaceSm">8</sys:Double>
    <sys:Double x:Key="SpaceMd">12</sys:Double>
    <sys:Double x:Key="SpaceLg">16</sys:Double>
    <sys:Double x:Key="SpaceXl">20</sys:Double>
    <sys:Double x:Key="Space2xl">24</sys:Double>
    <sys:Double x:Key="Space3xl">28</sys:Double>

    <Thickness x:Key="PadCard">14</Thickness>
    <Thickness x:Key="PadHero">16</Thickness>
    <Thickness x:Key="PadCompact">10</Thickness>
    <Thickness x:Key="PadPill">8,4</Thickness>
    <Thickness x:Key="PadField">10,8</Thickness>
    <Thickness x:Key="PadButton">12,8</Thickness>

    <!-- ============================================================ -->
    <!-- 5. Type: families and size scale                              -->
    <!-- ============================================================ -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <sys:Double x:Key="FontMicro">10</sys:Double>
    <sys:Double x:Key="FontMono">11</sys:Double>
    <sys:Double x:Key="FontCaption">12</sys:Double>
    <sys:Double x:Key="FontSmall">12</sys:Double>
    <sys:Double x:Key="FontLabel">13</sys:Double>
    <sys:Double x:Key="FontBody">14</sys:Double>
    <sys:Double x:Key="FontSection">16</sys:Double>
    <sys:Double x:Key="FontTitle">18</sys:Double>
    <sys:Double x:Key="FontDisplaySm">21</sys:Double>
    <sys:Double x:Key="FontMetric">32</sys:Double>
    <sys:Double x:Key="FontDisplay">26</sys:Double>

    <!-- ============================================================ -->
    <!-- 6. Motion durations (native-quiet: 120–200 ms)                  -->
    <!-- ============================================================ -->
    <Duration x:Key="MotionFast">0:0:0.12</Duration>
    <Duration x:Key="MotionBase">0:0:0.16</Duration>
    <Duration x:Key="MotionSlow">0:0:0.20</Duration>
</ResourceDictionary>
