<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Soltex.App</RootNamespace>
    <AssemblyName>Soltex</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Soltex.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WinUISDKReferences>false</WinUISDKReferences>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Soltex.RemoteAssist\Soltex.RemoteAssist.csproj" />
    <ProjectReference Include="..\Soltex.Security\Soltex.Security.csproj" />
    <ProjectReference Include="..\Soltex.Update\Soltex.Update.csproj" />
    <ProjectReference Include="..\Soltex.Monitoring\Soltex.Monitoring.csproj" />
    <ProjectReference Include="..\Soltex.DeviceFabric\Soltex.DeviceFabric.csproj" />
    <ProjectReference Include="..\Soltex.Audio\Soltex.Audio.csproj" />
    <ProjectReference Include="..\Soltex.Benchmarks\Soltex.Benchmarks.csproj" />
    <ProjectReference Include="..\Soltex.Whisper\Soltex.Whisper.csproj" />
    <ProjectReference Include="..\Soltex.Whisper.Windows\Soltex.Whisper.Windows.csproj" />
    <ProjectReference Include="..\Soltex.NativeShell\Soltex.NativeShell.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Soltex.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences"
                      Version="2.1.6"
                      PrivateAssets="all" />
  </ItemGroup>
  <Target Name="RemoveUnusedWinRtSourceGeneratorFromWpfHost"
          BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)"
                Condition="'%(Analyzer.Filename)' == 'WinRT.SourceGenerator'" />
    </ItemGroup>
  </Target>
</Project>
