<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Soltex.App.Tests</RootNamespace>
    <AssemblyName>Soltex.App.Tests</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Soltex.App\Soltex.App.csproj"
                      AdditionalProperties="OutputType=Library;WindowsAppSDKSelfContained=false" />
    <ProjectReference Include="..\..\src\Soltex.Audio\Soltex.Audio.csproj" />
    <ProjectReference Include="..\..\src\Soltex.DeviceFabric\Soltex.DeviceFabric.csproj" />
    <ProjectReference Include="..\..\src\Soltex.Monitoring\Soltex.Monitoring.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests load the projection metadata referenced by Soltex.NativeShell but
         do not activate or package the Windows App SDK runtime. -->
    <Reference Include="Microsoft.InteractiveExperiences.Projection">
      <HintPath>$(NuGetPackageRoot)\microsoft.windowsappsdk.interactiveexperiences\2.1.6\lib\net6.0-windows10.0.18362.0\Microsoft.InteractiveExperiences.Projection.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RemoveUnusedWinRtSourceGeneratorFromWpfTestHost"
          BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)"
                Condition="'%(Analyzer.Filename)' == 'WinRT.SourceGenerator'" />
    </ItemGroup>
  </Target>
</Project>
