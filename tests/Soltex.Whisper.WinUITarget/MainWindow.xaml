<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Soltex.Whisper.WinUiTarget.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Soltex Whisper WinUI target">
    <Grid Padding="32">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left" Spacing="12">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Whisper WinUI target" />
            <TextBlock
                Text="Owner-controlled editable surface for content-free integration evidence."
                TextWrapping="Wrap" />
            <TextBox
                x:Name="TargetTextBox"
                MinHeight="120"
                AcceptsReturn="True"
                AutomationProperties.AutomationId="SoltexWhisperWinUiTarget"
                AutomationProperties.Name="Controlled WinUI dictation target"
                Header="Controlled dictation target"
                PlaceholderText="Ready for the owner-controlled matrix"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="EnterReceiptStatus"
                AutomationProperties.AutomationId="SoltexWhisperWinUiEnterReceipt"
                Text="Enter receipts: 0" />
        </StackPanel>
    </Grid>
</Window>
